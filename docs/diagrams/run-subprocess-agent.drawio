        </mxCell>
        <mxCell id="pB" value="进程边界（spawn 时施加）— dsh 借鉴机制" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;verticalAlign=top;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1">
