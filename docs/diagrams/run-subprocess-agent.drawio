        </mxCell>
        <mxCell id="a1" value="门禁前置：Planning Gate +&lt;br&gt;Spec Review Gate（未过→拒绝执行）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
