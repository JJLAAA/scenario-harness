        <mxCell id="s7" value="分支精确匹配？&lt;br&gt;expected == actual" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
