        <mxCell id="1" parent="0" />
        <mxCell id="s1" value="run &lt;scenario&gt; --task &lt;id&gt;&lt;br&gt;[--repo --agent --permission --dry-run --timeout]" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1">
