          <mxGeometry x="270" y="472" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s6n" value="写 run-status：complete&lt;br&gt;exit 0" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="170" height="48" as="geometry" />
