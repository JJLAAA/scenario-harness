          <mxGeometry x="520" y="146" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Provider 适配层 — 统一契约 spawn / result / terminate（dsh⑥ provider seam）" style="text;html=1;align=center;fontStyle=1;fontSize=11;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="60" y="206" width="700" height="26" as="geometry" />
