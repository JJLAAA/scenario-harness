  <diagram id="run-arch" name="架构图">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pA" value="协调层 · Harness Root — 确定性 runner（无 LLM 编排）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;verticalAlign=top;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1">
