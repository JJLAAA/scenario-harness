        </mxCell>
        <mxCell id="b1" value="env allowlist overlay&lt;br&gt;白名单外环境变量全部丢弃&lt;br&gt;（dsh② scrubbedParentEnv）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="424" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="start_new_session&lt;br&gt;独立进程组 · cwd=仓库目录&lt;br&gt;（仓库本地配置启动即加载，&lt;br&gt;例外清单见 docs 核查表）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="290" y="424" width="220" height="60" as="geometry" />
    </mxCell>
        <mxCell id="b3" value="终止阶梯 + 超时&lt;br&gt;SIGTERM→宽限→SIGKILL（杀整组）&lt;br&gt;--timeout 默认 1800s（dsh① 进程树）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="424" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pC" value="业务仓库 ×N（独立 git 仓，按 scenario order 串行进入）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;verticalAlign=top;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="544" width="740" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="仓库 A（order[0]）&lt;br&gt;&lt;br&gt;cwd=仓库目录&lt;br&gt;AGENTS.md / 设置 hooks / skills 启动即加载&lt;br&gt;（headless 例外：subagent hooks 需交互信任、&lt;br&gt;审批型 MCP 受限，见 docs 核查表）&lt;br&gt;&lt;br&gt;子 Agent 实现代码，禁止 commit/push/checkout" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="60" y="588" width="220" height="130" as="geometry" />
    </mxCell>
        <mxCell id="c2" value="仓库 B（order[1]）&lt;br&gt;&lt;br&gt;同左&lt;br&gt;&lt;br&gt;depends_on 上游就绪后&lt;br&gt;方可进入" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="588" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="仓库 C（order[2]）&lt;br&gt;&lt;br&gt;同左&lt;br&gt;&lt;br&gt;runner 按序推进&lt;br&gt;首个失败即停止" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
