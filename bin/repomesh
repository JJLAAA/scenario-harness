#!/usr/bin/env python3
"""Agent-friendly helper CLI for RepoMesh."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

EXIT_OK = 0
EXIT_VALIDATION = 2
EXIT_USAGE = 64


class HarnessError(Exception):
    def __init__(self, message: str, exit_code: int = EXIT_VALIDATION):
        super().__init__(message)
        self.exit_code = exit_code


@dataclass
class Finding:
    level: str
    code: str
    message: str
    fix: str | None = None

    def to_dict(self) -> dict[str, Any]:
        data: dict[str, Any] = {
            "level": self.level,
            "code": self.code,
            "message": self.message,
        }
        if self.fix:
            data["fix"] = self.fix
        return data


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if value in ("", "null", "Null", "NULL", "~"):
        return None
    if value in ("true", "True", "TRUE"):
        return True
    if value in ("false", "False", "FALSE"):
        return False
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def next_content(lines: list[str], start: int) -> tuple[int, str] | None:
    for raw in lines[start:]:
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        return len(raw) - len(raw.lstrip(" ")), stripped
    return None


def parse_yaml_subset(text: str) -> Any:
    """Parse the small YAML subset used by this harness.

    Supported constructs: nested mappings and scalar lists, with indentation.
    This avoids a runtime dependency while keeping errors deterministic for agents.
    """

    lines = text.splitlines()
    root: dict[str, Any] = {}
    stack: list[tuple[int, Any]] = [(-1, root)]

    for index, raw in enumerate(lines):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "\t" in raw[: len(raw) - len(raw.lstrip())]:
            raise HarnessError("YAML indentation must use spaces, not tabs.")

        indent = len(raw) - len(raw.lstrip(" "))
        while indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]

        if stripped.startswith("- "):
            if not isinstance(parent, list):
                raise HarnessError(
                    f"YAML list item has no list parent near: {stripped}"
                )
            item = stripped[2:].strip()
            item_key = item.split(":", 1)[0].strip() if ":" in item else ""
            if ":" in item and re.match(r"^[A-Za-z_][A-Za-z0-9_-]*$", item_key):
                key, raw_value = item.split(":", 1)
                key = key.strip()
                raw_value = raw_value.strip()
                if not key:
                    raise HarnessError(
                        f"YAML list mapping key is empty near: {stripped}"
                    )
                mapping: dict[str, Any] = {}
                if raw_value:
                    mapping[key] = parse_scalar(raw_value)
                else:
                    raise HarnessError(
                        f"YAML list mapping values must be scalar near: {stripped}"
                    )
                parent.append(mapping)
                stack.append((indent, mapping))
                continue
            parent.append(parse_scalar(item))
            continue

        if ":" not in stripped:
            raise HarnessError(f"YAML mapping line is missing ':': {stripped}")

        key, raw_value = stripped.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if not key:
            raise HarnessError(f"YAML mapping key is empty near: {stripped}")
        if not isinstance(parent, dict):
            raise HarnessError(
                f"YAML mapping item has no mapping parent near: {stripped}"
            )

        if raw_value:
            parent[key] = parse_scalar(raw_value)
            continue

        following = next_content(lines, index + 1)
        child: Any = (
            []
            if following and following[0] > indent and following[1].startswith("- ")
            else {}
        )
        parent[key] = child
        stack.append((indent, child))

    return root


def load_yaml(path: Path) -> Any:
    try:
        import yaml  # type: ignore
    except ImportError as exc:
        try:
            with path.open("r", encoding="utf-8") as handle:
                return parse_yaml_subset(handle.read())
        except FileNotFoundError as file_exc:
            raise HarnessError(f"Required file is missing: {path}") from file_exc
        except HarnessError as parse_exc:
            raise HarnessError(f"Invalid YAML in {path}: {parse_exc}") from parse_exc

    try:
        with path.open("r", encoding="utf-8") as handle:
            return yaml.safe_load(handle) or {}
    except FileNotFoundError as exc:
        raise HarnessError(f"Required file is missing: {path}") from exc
    except yaml.YAMLError as exc:  # type: ignore[name-defined]
        raise HarnessError(f"Invalid YAML in {path}: {exc}") from exc


def harness_root() -> Path:
    return Path(__file__).resolve().parents[1]


def resolve_harness_path(root: Path, raw_path: str) -> Path:
    if "$" in raw_path:
        raise HarnessError(f"Invalid path contains shell-style variable: {raw_path}")
    path = Path(raw_path)
    if not path.is_absolute():
        path = root / path
    return path.resolve()


def load_scenario(root: Path, scenario: str) -> tuple[Path, dict[str, Any]]:
    scenario_dir = root / "scenarios" / scenario
    scenario_file = scenario_dir / "scenario.yaml"
    data = load_yaml(scenario_file)
    if not isinstance(data, dict):
        raise HarnessError(f"Scenario file must contain a mapping: {scenario_file}")
    return scenario_dir, data


def scenario_repos(scenario_data: dict[str, Any]) -> dict[str, Any]:
    repos = scenario_data.get("repos")
    if isinstance(repos, dict):
        return repos
    return {}


def selected_repo_keys(scenario_data: dict[str, Any]) -> tuple[list[str], list[str]]:
    repos = scenario_repos(scenario_data)
    order = scenario_data.get("order")
    if not isinstance(order, list) or not all(isinstance(item, str) for item in order):
        order = []
    return list(repos.keys()), list(order)


TASK_SPECIFIC_DEPENDENCY_FIELDS = {
    "branch",
    "commit",
    "dist-tag",
    "dist_tag",
    "file",
    "link",
    "ref",
    "sha",
    "tag",
    "tarball",
    "version",
    "workspace",
}


def non_empty_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def dependency_field_path(
    repo_key: str, field: str, index: int, key: str | None = None
) -> str:
    path = f"repos.{repo_key}.{field}[{index}]"
    if key:
        path += f".{key}"
    return path


def validate_task_specific_fields(
    repo_key: str,
    field: str,
    index: int,
    item: dict[str, Any],
    findings: list[Finding],
) -> None:
    for key in sorted(set(item) & TASK_SPECIFIC_DEPENDENCY_FIELDS):
        findings.append(
            Finding(
                "error",
                "task_specific_dependency_field",
                f"{dependency_field_path(repo_key, field, index, key)} is task-specific and must not be declared in scenario.yaml.",
                "Ask a human to confirm this value for the task, then record it in the task files.",
            )
        )


def validate_dependency_metadata(
    repos_config: dict[str, Any],
    order: list[str],
    findings: list[Finding],
) -> None:
    outputs_by_repo: dict[str, set[str]] = {}

    for repo_key, repo_entry in repos_config.items():
        if not isinstance(repo_entry, dict):
            continue

        outputs = repo_entry.get("outputs")
        if outputs is None:
            continue
        if not isinstance(outputs, list):
            findings.append(
                Finding(
                    "error",
                    "invalid_outputs",
                    f"repos.{repo_key}.outputs must be a list of output mappings when present.",
                    "Use list items with id, type, and name fields.",
                )
            )
            continue

        seen: set[str] = set()
        for index, output in enumerate(outputs):
            if not isinstance(output, dict):
                findings.append(
                    Finding(
                        "error",
                        "invalid_output",
                        f"{dependency_field_path(repo_key, 'outputs', index)} must be a mapping.",
                        "Use a mapping such as '- id: profile-client'.",
                    )
                )
                continue

            validate_task_specific_fields(repo_key, "outputs", index, output, findings)
            for key in ("id", "type", "name"):
                if not non_empty_string(output.get(key)):
                    findings.append(
                        Finding(
                            "error",
                            "invalid_output",
                            f"{dependency_field_path(repo_key, 'outputs', index, key)} must be a non-empty string.",
                            f"Set {dependency_field_path(repo_key, 'outputs', index, key)}.",
                        )
                    )

            output_id = output.get("id")
            if not non_empty_string(output_id):
                continue
            if output_id in seen:
                findings.append(
                    Finding(
                        "error",
                        "duplicate_output",
                        f"repos.{repo_key}.outputs contains duplicate id '{output_id}'.",
                        "Use a unique stable output id within each repo.",
                    )
                )
                continue
            seen.add(output_id)
            outputs_by_repo.setdefault(repo_key, set()).add(output_id)

    order_positions = {repo_key: index for index, repo_key in enumerate(order)}
    for repo_key, repo_entry in repos_config.items():
        if not isinstance(repo_entry, dict):
            continue

        dependencies = repo_entry.get("depends_on")
        if dependencies is None:
            continue
        if not isinstance(dependencies, list):
            findings.append(
                Finding(
                    "error",
                    "invalid_depends_on",
                    f"repos.{repo_key}.depends_on must be a list of dependency mappings when present.",
                    "Use list items with repo, output, and optional reason fields.",
                )
            )
            continue

        seen_dependencies: set[tuple[str, str]] = set()
        for index, dependency in enumerate(dependencies):
            if not isinstance(dependency, dict):
                findings.append(
                    Finding(
                        "error",
                        "invalid_dependency",
                        f"{dependency_field_path(repo_key, 'depends_on', index)} must be a mapping.",
                        "Use a mapping such as '- repo: contract-repo'.",
                    )
                )
                continue

            validate_task_specific_fields(
                repo_key, "depends_on", index, dependency, findings
            )

            producer = dependency.get("repo")
            output_id = dependency.get("output")
            if not non_empty_string(producer):
                findings.append(
                    Finding(
                        "error",
                        "invalid_dependency",
                        f"{dependency_field_path(repo_key, 'depends_on', index, 'repo')} must be a non-empty string.",
                        f"Set {dependency_field_path(repo_key, 'depends_on', index, 'repo')} to an upstream repo key.",
                    )
                )
            if not non_empty_string(output_id):
                findings.append(
                    Finding(
                        "error",
                        "invalid_dependency",
                        f"{dependency_field_path(repo_key, 'depends_on', index, 'output')} must be a non-empty string.",
                        f"Set {dependency_field_path(repo_key, 'depends_on', index, 'output')} to an upstream output id.",
                    )
                )
            reason = dependency.get("reason")
            if reason is not None and not isinstance(reason, str):
                findings.append(
                    Finding(
                        "error",
                        "invalid_dependency",
                        f"{dependency_field_path(repo_key, 'depends_on', index, 'reason')} must be a string when present.",
                        "Use a short human-readable reason or remove the field.",
                    )
                )

            if not non_empty_string(producer) or not non_empty_string(output_id):
                continue

            dependency_key = (producer, output_id)
            if dependency_key in seen_dependencies:
                findings.append(
                    Finding(
                        "error",
                        "duplicate_dependency",
                        f"repos.{repo_key}.depends_on contains duplicate dependency on '{producer}' output '{output_id}'.",
                        "Declare each producer/output dependency once per consumer repo.",
                    )
                )
            seen_dependencies.add(dependency_key)

            if producer == repo_key:
                findings.append(
                    Finding(
                        "error",
                        "self_dependency",
                        f"repos.{repo_key}.depends_on[{index}] references the same repo.",
                        "Remove self-dependencies; repo-local relationships belong in repo-local documentation.",
                    )
                )
                continue

            if producer not in repos_config:
                findings.append(
                    Finding(
                        "error",
                        "unknown_dependency_repo",
                        f"repos.{repo_key}.depends_on[{index}].repo references unknown repo '{producer}'.",
                        "Reference a repo key declared under scenario.yaml repos.",
                    )
                )
                continue

            producer_outputs = outputs_by_repo.get(producer, set())
            if output_id not in producer_outputs:
                findings.append(
                    Finding(
                        "error",
                        "unknown_dependency_output",
                        f"repos.{repo_key}.depends_on[{index}].output references unknown output '{output_id}' from '{producer}'.",
                        f"Declare repos.{producer}.outputs with id '{output_id}', or update the dependency.",
                    )
                )

            if producer in order_positions and repo_key in order_positions:
                if order_positions[producer] >= order_positions[repo_key]:
                    findings.append(
                        Finding(
                            "error",
                            "dependency_order",
                            f"Repo '{repo_key}' depends on output '{output_id}' from '{producer}', but '{producer}' does not appear before '{repo_key}' in order.",
                            "Move producer repos before consumer repos in scenario.yaml order.",
                        )
                    )


def scenario_registry_crosscheck(
    root: Path, scenario: str, scenario_data: dict[str, Any], findings: list[Finding]
) -> None:
    """Q3-B: warning-level drift signal between this scenario and repos.yaml.

    Scenario self-containment is unchanged: the registry never gates scenario
    execution, and an absent registry produces no findings at all.
    """

    registry_file = root / REGISTRY_FILE_NAME
    if not registry_file.exists():
        return
    try:
        registry = load_yaml(registry_file)
    except HarnessError as exc:
        findings.append(
            Finding(
                "warning",
                "registry_unreadable",
                f"repos.yaml could not be read for the consistency cross-check: {exc}",
                "Fix repos.yaml or remove it; scenario validation itself does not depend on it.",
            )
        )
        return
    if not isinstance(registry, dict):
        return
    registry_repos_config = registry_repos(registry)
    for repo_key, entry in scenario_repos(scenario_data).items():
        if not isinstance(entry, dict):
            continue
        registry_entry = registry_repos_config.get(repo_key)
        if not isinstance(registry_entry, dict):
            findings.append(
                repo_not_in_registry_finding(scenario, repo_key, "repos.yaml")
            )
            continue
        diverged = intrinsic_field_divergences(repo_key, registry_entry, entry)
        if diverged:
            findings.append(
                field_divergence_finding(
                    repo_key, diverged, f"scenario '{scenario}'"
                )
            )


def validate_scenario(root: Path, scenario: str) -> dict[str, Any]:
    findings: list[Finding] = []

    scenario_dir = root / "scenarios" / scenario
    scenario_file = scenario_dir / "scenario.yaml"
    readme_file = scenario_dir / "README.md"

    if not scenario_file.exists():
        raise HarnessError(
            f"Scenario config is missing: {scenario_file}",
            EXIT_VALIDATION,
        )

    scenario_dir, scenario_data = load_scenario(root, scenario)
    repos, order = selected_repo_keys(scenario_data)
    repos_config = scenario_repos(scenario_data)

    if not readme_file.exists():
        findings.append(
            Finding(
                "error",
                "missing_scenario_readme",
                f"Scenario README is missing: {readme_file}",
                f"Create {readme_file} with SOP, invariants, and completion criteria.",
            )
        )

    if not repos:
        findings.append(
            Finding(
                "error",
                "invalid_repos",
                "scenario.yaml must include a non-empty 'repos' mapping.",
                "Add repos.<repo-key> entries with path, instructions, key files, and checks.",
            )
        )

    if not order:
        findings.append(
            Finding(
                "error",
                "invalid_order",
                "scenario.yaml must include a non-empty 'order' list of repo keys.",
                "Add the authoritative execution order.",
            )
        )

    if set(repos) != set(order):
        missing_from_order = sorted(set(repos) - set(order))
        missing_from_repos = sorted(set(order) - set(repos))
        detail = []
        if missing_from_order:
            detail.append(f"missing from order: {', '.join(missing_from_order)}")
        if missing_from_repos:
            detail.append(f"missing from repos: {', '.join(missing_from_repos)}")
        findings.append(
            Finding(
                "error",
                "repo_order_mismatch",
                "scenario.yaml 'repos' and 'order' must contain the same repo keys"
                + (f" ({'; '.join(detail)})" if detail else "."),
                "Make 'repos' and 'order' contain the same keys; keep sequence only in 'order'.",
            )
        )

    validate_dependency_metadata(repos_config, order, findings)
    scenario_registry_crosscheck(root, scenario, scenario_data, findings)

    selected = order or repos
    repo_reports: list[dict[str, Any]] = []
    for repo_key in selected:
        repo_report: dict[str, Any] = {"key": repo_key}
        repo_entry = repos_config.get(repo_key)

        if not isinstance(repo_entry, dict):
            findings.append(
                Finding(
                    "error",
                    "unknown_repo",
                    f"Scenario order references repo '{repo_key}' but repos has no matching entry.",
                    f"Add repos.{repo_key} to scenario.yaml or remove it from order.",
                )
            )
            repo_report["config"] = "missing"
        else:
            raw_path = repo_entry.get("path")
            if not isinstance(raw_path, str) or not raw_path:
                findings.append(
                    Finding(
                        "error",
                        "missing_repo_path",
                        f"repos.{repo_key}.path must be a non-empty string.",
                        f"Set repos.{repo_key}.path to the local repository path.",
                    )
                )
            else:
                try:
                    resolved_path = resolve_harness_path(root, raw_path)
                    repo_report["path"] = str(resolved_path)
                    if not resolved_path.exists():
                        findings.append(
                            Finding(
                                "error",
                                "repo_path_missing",
                                f"Repo path does not exist for '{repo_key}': {resolved_path}",
                                "Clone or move the repository, or update scenario.yaml.",
                            )
                        )
                    elif not (resolved_path / ".git").exists():
                        findings.append(
                            Finding(
                                "warning",
                                "repo_path_not_git",
                                f"Repo path for '{repo_key}' does not contain .git: {resolved_path}",
                                "Confirm the path points at the repository root.",
                            )
                        )
                except HarnessError as exc:
                    findings.append(
                        Finding(
                            "error",
                            "invalid_repo_path",
                            str(exc),
                            f"Use an absolute path or a path relative to {root}.",
                        )
                    )

            checks = repo_entry.get("checks")
            if checks is not None and (
                not isinstance(checks, list)
                or not all(isinstance(item, str) for item in checks)
            ):
                findings.append(
                    Finding(
                        "error",
                        "invalid_checks",
                        f"repos.{repo_key}.checks must be a list of command strings when present.",
                        "Use YAML list items such as '- npm test'.",
                    )
                )

            for field in ("instruction_sources", "key_files"):
                value = repo_entry.get(field)
                if value is not None and (
                    not isinstance(value, list)
                    or not all(isinstance(item, str) for item in value)
                ):
                    findings.append(
                        Finding(
                            "error",
                            f"invalid_{field}",
                            f"repos.{repo_key}.{field} must be a list of strings when present.",
                            f"Use YAML list items under repos.{repo_key}.{field}.",
                        )
                    )

        repo_reports.append(repo_report)

    status = "ok" if not any(item.level == "error" for item in findings) else "error"
    return {
        "status": status,
        "scenario": scenario,
        "scenario_file": str(scenario_file),
        "scenario_readme": str(readme_file),
        "repos": repo_reports,
        "findings": [item.to_dict() for item in findings],
    }


def scenario_context(root: Path, scenario: str) -> dict[str, Any]:
    scenario_dir, scenario_data = load_scenario(root, scenario)
    repos, order = selected_repo_keys(scenario_data)
    repos_config = scenario_repos(scenario_data)

    selected = order or repos
    entries: list[dict[str, Any]] = []
    for repo_key in selected:
        repo_entry = repos_config.get(repo_key)
        if not isinstance(repo_entry, dict):
            repo_entry = {}
        raw_path = repo_entry.get("path")
        resolved_path = None
        if isinstance(raw_path, str) and raw_path:
            resolved_path = str(resolve_harness_path(root, raw_path))
        entries.append(
            {
                "key": repo_key,
                "path": resolved_path,
                "role": repo_entry.get("role"),
                "description": repo_entry.get("description"),
                "outputs": repo_entry.get("outputs") or [],
                "depends_on": repo_entry.get("depends_on") or [],
                "instruction_sources": repo_entry.get("instruction_sources") or [],
                "key_files": repo_entry.get("key_files") or [],
                "checks": repo_entry.get("checks") or [],
            }
        )

    return {
        "scenario": scenario,
        "scenario_dir": str(scenario_dir),
        "description": scenario_data.get("description") or "",
        "repos": entries,
    }


REGISTRY_FILE_NAME = "repos.yaml"
REGISTRY_INTRINSIC_FIELDS = ("path", "description", "instruction_sources", "key_files", "checks")


def load_registry(root: Path) -> dict[str, Any]:
    data = load_yaml(root / REGISTRY_FILE_NAME)
    if not isinstance(data, dict):
        raise HarnessError(
            f"Registry file must contain a mapping: {root / REGISTRY_FILE_NAME}"
        )
    return data


def registry_repos(registry: dict[str, Any]) -> dict[str, Any]:
    repos = registry.get("repos")
    return repos if isinstance(repos, dict) else {}


def intrinsic_field_divergences(
    repo_key: str, registry_entry: dict[str, Any], other_entry: dict[str, Any]
) -> list[str]:
    """Intrinsic fields declared on both sides that carry different values."""

    diverged = []
    for field in REGISTRY_INTRINSIC_FIELDS:
        if field in registry_entry and field in other_entry:
            if registry_entry[field] != other_entry[field]:
                diverged.append(field)
    return diverged


def repo_not_in_registry_finding(
    scenario: str, repo_key: str, registry_label: str
) -> Finding:
    return Finding(
        "warning",
        "repo_not_in_registry",
        f"Scenario '{scenario}' declares repo '{repo_key}' which is not registered in {registry_label}.",
        "Register the repo in repos.yaml under the same key as scenario.yaml so free-task tooling can see it, or confirm the exclusion.",
    )


def field_divergence_finding(
    repo_key: str, diverged: list[str], other_label: str
) -> Finding:
    return Finding(
        "warning",
        "registry_field_divergence",
        f"repos.{repo_key} {'/'.join(sorted(diverged))} in repos.yaml diverges from {other_label}.",
        "Keep intrinsic fields identical in both files, or drop them from one side, so drift stays observable.",
    )


def registry_scenario_crosscheck(
    root: Path, registry: dict[str, Any], findings: list[Finding]
) -> list[dict[str, Any]]:
    """Q4-a static consistency: scenario repo keys and fields vs registry.

    Warning level only. The registry is an accelerator, never authority:
    mismatches make drift observable but never gate scenario execution.
    """

    scenarios_root = root / "scenarios"
    if not scenarios_root.exists():
        return []
    registry_repos_config = registry_repos(registry)
    repo_keys = set(registry_repos_config)
    summaries: list[dict[str, Any]] = []
    for scenario_dir in sorted(scenarios_root.iterdir()):
        scenario_file = scenario_dir / "scenario.yaml"
        if not scenario_dir.is_dir() or not scenario_file.exists():
            continue
        try:
            scenario_data = load_yaml(scenario_file)
        except HarnessError:
            continue  # scenario-side validation owns scenario errors
        if not isinstance(scenario_data, dict):
            continue
        summary: dict[str, Any] = {
            "scenario": scenario_dir.name,
            "missing_repos": [],
            "divergent_repos": {},
        }
        for repo_key, entry in scenario_repos(scenario_data).items():
            if not isinstance(entry, dict):
                continue
            registry_entry = registry_repos_config.get(repo_key)
            if not isinstance(registry_entry, dict):
                summary["missing_repos"].append(repo_key)
                findings.append(
                    repo_not_in_registry_finding(scenario_dir.name, repo_key, "repos.yaml")
                )
                continue
            diverged = intrinsic_field_divergences(repo_key, registry_entry, entry)
            if diverged:
                summary["divergent_repos"][repo_key] = diverged
                findings.append(
                    field_divergence_finding(
                        repo_key, diverged, f"scenario '{scenario_dir.name}'"
                    )
                )
        summaries.append(summary)
    return summaries


def validate_registry_edges(
    registry: dict[str, Any], repos: dict[str, Any], findings: list[Finding]
) -> list[dict[str, Any]]:
    edges = registry.get("edges")
    if edges is None:
        return []
    if not isinstance(edges, list):
        findings.append(
            Finding(
                "error",
                "invalid_edges",
                "repos.yaml 'edges' must be a list of edge mappings when present.",
                "Use list items with from, to, and evidence fields.",
            )
        )
        return []

    reports: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for index, edge in enumerate(edges):
        path = f"edges[{index}]"
        if not isinstance(edge, dict):
            findings.append(
                Finding(
                    "error",
                    "invalid_edge",
                    f"{path} must be a mapping.",
                    "Use a mapping such as '- from: consumer-repo'.",
                )
            )
            continue

        for field in sorted(set(edge) & TASK_SPECIFIC_DEPENDENCY_FIELDS):
            findings.append(
                Finding(
                    "error",
                    "task_specific_dependency_field",
                    f"{path}.{field} is task-specific and must not be declared in repos.yaml.",
                    "Remove the field; task-level values live in the task files.",
                )
            )

        source = edge.get("from")
        target = edge.get("to")
        evidence = edge.get("evidence")
        for key in ("from", "to"):
            if not non_empty_string(edge.get(key)):
                findings.append(
                    Finding(
                        "error",
                        "invalid_edge",
                        f"{path}.{key} must be a non-empty string.",
                        f"Set {path}.{key} to a repo key declared under repos.",
                    )
                )
        if not non_empty_string(evidence):
            findings.append(
                Finding(
                    "error",
                    "invalid_edge_evidence",
                    f"{path}.evidence must be a non-empty string.",
                    "Cite how the dependency is observable (manifest line, import, generated-code source). Evidence text is never parsed for semantics.",
                )
            )

        report: dict[str, Any] = {
            "from": source if isinstance(source, str) else None,
            "to": target if isinstance(target, str) else None,
        }
        if non_empty_string(source) and non_empty_string(target):
            if source == target:
                findings.append(
                    Finding(
                        "error",
                        "edge_self",
                        f"{path} references the same repo on both ends.",
                        "Remove self-edges; repo-local relationships stay in repo-local documentation.",
                    )
                )
            else:
                for key, endpoint in (("from", source), ("to", target)):
                    if endpoint not in repos:
                        findings.append(
                            Finding(
                                "error",
                                "edge_endpoint_unknown",
                                f"{path}.{key} references unknown repo '{endpoint}'.",
                                "Reference a repo key declared under repos.yaml repos.",
                            )
                        )
                pair = (source, target)
                if pair in seen:
                    findings.append(
                        Finding(
                            "error",
                            "duplicate_edge",
                            f"edges contains duplicate pair '{source}' -> '{target}'.",
                            "(from, to) is the natural key; declare each pair once.",
                        )
                    )
                seen.add(pair)
        reports.append(report)
    return reports


def validate_registry(root: Path) -> dict[str, Any]:
    findings: list[Finding] = []
    registry_file = root / REGISTRY_FILE_NAME
    if not registry_file.exists():
        raise HarnessError(
            f"Required file is missing: {registry_file}", EXIT_VALIDATION
        )

    registry = load_registry(root)
    repos = registry_repos(registry)

    if not repos:
        findings.append(
            Finding(
                "error",
                "invalid_repos",
                "repos.yaml must include a non-empty 'repos' mapping.",
                "Add repos.<repo-key> entries with path and the repo's intrinsic fields.",
            )
        )

    repo_reports: list[dict[str, Any]] = []
    for repo_key, repo_entry in repos.items():
        repo_report: dict[str, Any] = {"key": repo_key}
        if not isinstance(repo_entry, dict):
            findings.append(
                Finding(
                    "error",
                    "invalid_repo_entry",
                    f"repos.{repo_key} must be a mapping.",
                    "Use a mapping with path and the repo's intrinsic fields.",
                )
            )
            repo_reports.append(repo_report)
            continue

        for field in sorted(set(repo_entry) & TASK_SPECIFIC_DEPENDENCY_FIELDS):
            findings.append(
                Finding(
                    "error",
                    "task_specific_dependency_field",
                    f"repos.{repo_key}.{field} is task-specific and must not be declared in repos.yaml.",
                    "Ask a human to confirm this value for the task, then record it in the task files.",
                )
            )

        raw_path = repo_entry.get("path")
        if not isinstance(raw_path, str) or not raw_path:
            findings.append(
                Finding(
                    "error",
                    "missing_repo_path",
                    f"repos.{repo_key}.path must be a non-empty string.",
                    f"Set repos.{repo_key}.path to the local repository path.",
                )
            )
        else:
            try:
                resolved_path = resolve_harness_path(root, raw_path)
                repo_report["path"] = str(resolved_path)
                if not resolved_path.exists():
                    findings.append(
                        Finding(
                            "error",
                            "repo_path_missing",
                            f"Repo path does not exist for '{repo_key}': {resolved_path}",
                            "Clone or move the repository, or update repos.yaml.",
                        )
                    )
                elif not (resolved_path / ".git").exists():
                    findings.append(
                        Finding(
                            "warning",
                            "repo_path_not_git",
                            f"Repo path for '{repo_key}' does not contain .git: {resolved_path}",
                            "Confirm the path points at the repository root.",
                        )
                    )
            except HarnessError as exc:
                findings.append(
                    Finding(
                        "error",
                        "invalid_repo_path",
                        str(exc),
                        f"Use an absolute path or a path relative to {root}.",
                    )
                )

        for field in ("instruction_sources", "key_files", "checks"):
            value = repo_entry.get(field)
            if value is not None and (
                not isinstance(value, list)
                or not all(isinstance(item, str) for item in value)
            ):
                findings.append(
                    Finding(
                        "error",
                        f"invalid_{field}",
                        f"repos.{repo_key}.{field} must be a list of strings when present.",
                        f"Use YAML list items under repos.{repo_key}.{field}.",
                    )
                )
        repo_reports.append(repo_report)

    edge_reports = validate_registry_edges(registry, repos, findings)
    scenarios = registry_scenario_crosscheck(root, registry, findings)

    status = "ok" if not any(item.level == "error" for item in findings) else "error"
    return {
        "status": status,
        "registry_file": str(registry_file),
        "repos": repo_reports,
        "edges": edge_reports,
        "scenarios": scenarios,
        "findings": [item.to_dict() for item in findings],
    }


def markdown_list(items: list[str], empty: str = "None.") -> str:
    if not items:
        return empty
    return "\n".join(f"- `{item}`" for item in items)


def markdown_outputs(outputs: list[Any]) -> str:
    rows = []
    for output in outputs:
        if not isinstance(output, dict):
            continue
        label = output.get("id") or "TBD"
        details = []
        if output.get("type"):
            details.append(f"type `{output['type']}`")
        if output.get("name"):
            details.append(f"name `{output['name']}`")
        rows.append(f"- `{label}`" + (f" ({', '.join(details)})" if details else ""))
    return "\n".join(rows) if rows else "None."


def markdown_dependencies(dependencies: list[Any]) -> str:
    rows = []
    for dependency in dependencies:
        if not isinstance(dependency, dict):
            continue
        producer = dependency.get("repo") or "TBD"
        output = dependency.get("output") or "TBD"
        reason = dependency.get("reason")
        rows.append(
            f"- `{producer}` output `{output}`"
            + (f": {reason}" if isinstance(reason, str) and reason else "")
        )
    return "\n".join(rows) if rows else "None."


def run_git(repo_path: str, args: list[str]) -> tuple[int, str, str]:
    process = subprocess.run(
        ["git", "-C", repo_path, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    return process.returncode, process.stdout.strip(), process.stderr.strip()


def parse_branch_overrides(values: list[str] | None) -> dict[str, str]:
    branches: dict[str, str] = {}
    for value in values or []:
        if "=" not in value:
            raise HarnessError(
                f"Invalid --repo-branch value '{value}'. Expected REPO=BRANCH.",
                EXIT_USAGE,
            )
        repo_key, branch = value.split("=", 1)
        repo_key = repo_key.strip()
        branch = branch.strip()
        if not repo_key or not branch:
            raise HarnessError(
                f"Invalid --repo-branch value '{value}'. Expected non-empty REPO=BRANCH.",
                EXIT_USAGE,
            )
        branches[repo_key] = branch
    return branches


def task_branch_map(
    context: dict[str, Any], shared_branch: str, overrides: dict[str, str]
) -> dict[str, str]:
    repo_keys = {repo["key"] for repo in context["repos"]}
    unknown = sorted(set(overrides) - repo_keys)
    if unknown:
        raise HarnessError(
            f"Branch override references repo not in scenario: {', '.join(unknown)}",
            EXIT_USAGE,
        )
    return {
        repo["key"]: overrides.get(repo["key"], shared_branch)
        for repo in context["repos"]
    }


def read_task_branches(task_dir: Path) -> dict[str, str]:
    status_file = task_dir / "status.md"
    if not status_file.exists():
        return {}
    branches: dict[str, str] = {}
    text = strip_marked_blocks(status_file.read_text(encoding="utf-8"))
    for line in text.splitlines():
        if not line.startswith("|") or "---" in line or "Repo" in line:
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3:
            continue
        repo_key = re.sub(r"^`|`$", "", cells[0])
        expected_branch = re.sub(r"^`|`$", "", cells[2])
        if repo_key and expected_branch and expected_branch not in {"-", "TBD"}:
            branches[repo_key] = expected_branch
    return branches


def parse_task_mode(status_text: str) -> str | None:
    """Return 'free', 'scenario:<name>', or None for legacy task files.

    Legacy files without a mode line are interpreted as scenario tasks by the
    caller; the harness never writes a task without a mode line anymore.
    """

    text = strip_marked_blocks(status_text)
    match = re.search(
        r"^mode\s*[:\-]\s*`?(free|scenario:[A-Za-z0-9_-]+)`?\s*$",
        text,
        re.IGNORECASE | re.MULTILINE,
    )
    if not match:
        return None
    value = match.group(1).lower()
    return "free" if value == "free" else f"scenario:{value.split(':', 1)[1]}"


def read_task_mode(task_dir: Path) -> tuple[str | None, str | None]:
    """Return (kind, scenario): ('free', None), ('scenario', name), or (None, None)."""

    status_file = task_dir / "status.md"
    if not status_file.exists():
        return (None, None)
    status_text = status_file.read_text(encoding="utf-8")
    mode = parse_task_mode(status_text)
    if mode == "free":
        return ("free", None)
    if mode and mode.startswith("scenario:"):
        return ("scenario", mode.split(":", 1)[1])
    text = strip_marked_blocks(status_text)
    match = re.search(
        r"^scenario\s*[:\-]\s*`?([A-Za-z0-9_-]+)`?",
        text,
        re.IGNORECASE | re.MULTILINE,
    )
    if match and match.group(1).lower() != "none":
        return ("scenario", match.group(1))
    return (None, None)


def read_task_repo_rows(task_dir: Path) -> list[tuple[str, str | None]]:
    """Ordered (repo key, expected branch or None) rows from the per-repo table.

    For free tasks the row order is the task-declared execution order consumed
    by preflight, checks, and run.
    """

    status_file = task_dir / "status.md"
    if not status_file.exists():
        return []
    text = strip_marked_blocks(status_file.read_text(encoding="utf-8"))
    rows: list[tuple[str, str | None]] = []
    seen: set[str] = set()
    for line in text.splitlines():
        if not line.startswith("|") or "---" in line or "Repo" in line:
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3:
            continue
        repo_key = re.sub(r"^`|`$", "", cells[0])
        branch = re.sub(r"^`|`$", "", cells[2])
        if not repo_key or repo_key in seen:
            continue
        seen.add(repo_key)
        rows.append(
            (repo_key, branch if branch and branch not in {"-", "TBD"} else None)
        )
    return rows


def read_task_branch_defaults(task_dir: Path) -> dict[str, Any]:
    """Branch expectations recorded by init-task --free before repos are known."""

    status_file = task_dir / "status.md"
    if not status_file.exists():
        return {"default": None, "overrides": {}}
    text = strip_marked_blocks(status_file.read_text(encoding="utf-8"))
    default = None
    match = re.search(
        r"default expected branch\s*[:\-]\s*`?([^\s`]+)`?", text, re.IGNORECASE
    )
    if match:
        default = match.group(1)
    overrides: dict[str, str] = {}
    for repo, branch in re.findall(r"-\s*`([A-Za-z0-9_.-]+)`\s*=\s*`([^\s`]+)`", text):
        overrides[repo] = branch
    return {"default": default, "overrides": overrides}


def free_task_context(root: Path, task_dir: Path) -> dict[str, Any]:
    """Context for a free task: task-declared topology resolved against repos.yaml.

    This is the free-task sibling of scenario_context. Everything downstream
    (prompt rendering, branch gates, verdicts, checks) consumes the same shape
    and does not care where the context came from.
    """

    registry = load_registry(root)
    repos_config = registry_repos(registry)
    rows = read_task_repo_rows(task_dir)
    if not rows:
        raise HarnessError(
            "Free task declares no repositories in the status.md per-repo table. "
            "The Planning Pass must fill the table (row order = execution order) "
            "before the task can run.",
            EXIT_VALIDATION,
        )
    entries: list[dict[str, Any]] = []
    for repo_key, _branch in rows:
        repo_entry = repos_config.get(repo_key)
        if not isinstance(repo_entry, dict):
            raise HarnessError(
                f"Task declares repo '{repo_key}' which is not registered in repos.yaml.",
                EXIT_VALIDATION,
            )
        raw_path = repo_entry.get("path")
        resolved_path = None
        if isinstance(raw_path, str) and raw_path:
            resolved_path = str(resolve_harness_path(root, raw_path))
        entries.append(
            {
                "key": repo_key,
                "path": resolved_path,
                "role": None,
                "description": repo_entry.get("description"),
                "outputs": [],
                "depends_on": [],
                "instruction_sources": repo_entry.get("instruction_sources") or [],
                "key_files": repo_entry.get("key_files") or [],
                "checks": repo_entry.get("checks") or [],
            }
        )
    return {
        "scenario": "free",
        "mode": "free",
        "scenario_dir": None,
        "description": "",
        "repos": entries,
    }


def resolve_task_dir(root: Path, raw_task: str) -> Path:
    path = Path(raw_task)
    if path.is_absolute():
        return path
    if len(path.parts) == 1:
        return root / "tasks" / raw_task
    return (root / path).resolve()


MARKED_BLOCK_RE = re.compile(
    r"<!-- repomesh:[a-z0-9-]+:start -->.*?"
    r"<!-- repomesh:[a-z0-9-]+:end -->\n?",
    flags=re.S,
)


def strip_marked_blocks(text: str) -> str:
    """Drop runner-managed marked blocks so table scans only see authored content.

    Run reports upserted into task files contain their own tables; without this,
    scans like read_task_branches would read derived report cells as task data.
    """

    return MARKED_BLOCK_RE.sub("", text)


def upsert_marked_block(path: Path, marker: str, content: str) -> None:
    start = f"<!-- repomesh:{marker}:start -->"
    end = f"<!-- repomesh:{marker}:end -->"
    block = f"{start}\n{content.rstrip()}\n{end}\n"
    existing = path.read_text(encoding="utf-8") if path.exists() else ""
    if start in existing and end in existing:
        before = existing.split(start, 1)[0]
        after = existing.split(end, 1)[1]
        path.write_text(before + block + after.lstrip("\n"), encoding="utf-8")
        return
    separator = "" if not existing or existing.endswith("\n") else "\n"
    path.write_text(existing + separator + "\n" + block, encoding="utf-8")


def collect_preflight(
    root: Path,
    scenario: str,
    expected_branches: dict[str, str] | None = None,
    context: dict[str, Any] | None = None,
    validation: dict[str, Any] | None = None,
    path_source: str = "scenario.yaml",
) -> dict[str, Any]:
    validation = validation if validation is not None else validate_scenario(root, scenario)
    context = context if context is not None else scenario_context(root, scenario)
    findings: list[Finding] = []
    repo_results: list[dict[str, Any]] = []
    expected_branches = expected_branches or {}

    for repo in context["repos"]:
        repo_key = repo["key"]
        repo_path = repo.get("path")
        expected_branch = expected_branches.get(repo_key)
        result: dict[str, Any] = {
            "key": repo_key,
            "path": repo_path,
            "expected_branch": expected_branch,
            "actual_branch": None,
            "branch_result": "pending",
            "dirty": None,
            "git_status": "",
            "missing_instruction_sources": [],
            "missing_key_files": [],
            "errors": [],
        }

        if not repo_path or not Path(repo_path).exists():
            message = f"Repo path is missing for '{repo_key}': {repo_path or 'TBD'}"
            result["errors"].append(message)
            findings.append(
                Finding(
                    "error",
                    "repo_path_missing",
                    message,
                    f"Fix {path_source} path before entry.",
                )
            )
            repo_results.append(result)
            continue

        branch_code, branch_stdout, branch_stderr = run_git(
            repo_path, ["branch", "--show-current"]
        )
        status_code, status_stdout, status_stderr = run_git(
            repo_path, ["status", "--short", "--branch"]
        )
        if branch_code != 0:
            message = f"Could not read git branch for '{repo_key}': {branch_stderr or branch_stdout}"
            result["errors"].append(message)
            findings.append(
                Finding(
                    "error",
                    "git_branch_failed",
                    message,
                    "Confirm the repo path is a git repository.",
                )
            )
        else:
            result["actual_branch"] = branch_stdout
            if not expected_branch:
                result["branch_result"] = "not_configured"
            elif branch_stdout == expected_branch:
                result["branch_result"] = "pass"
            else:
                result["branch_result"] = "fail"
                findings.append(
                    Finding(
                        "error",
                        "branch_mismatch",
                        f"Repo '{repo_key}' is on '{branch_stdout}', expected task branch '{expected_branch}'.",
                        "Stop before reading repo-local context or editing; ask for direction.",
                    )
                )

        if status_code != 0:
            message = f"Could not read git status for '{repo_key}': {status_stderr or status_stdout}"
            result["errors"].append(message)
            findings.append(
                Finding(
                    "error",
                    "git_status_failed",
                    message,
                    "Confirm the repo path is a git repository.",
                )
            )
        else:
            result["git_status"] = status_stdout
            status_lines = [
                line
                for line in status_stdout.splitlines()
                if line and not line.startswith("##")
            ]
            result["dirty"] = bool(status_lines)

        for instruction in repo.get("instruction_sources") or []:
            if not (Path(repo_path) / instruction).exists():
                result["missing_instruction_sources"].append(instruction)
                findings.append(
                    Finding(
                        "warning",
                        "missing_instruction_source",
                        f"Repo '{repo_key}' instruction source is missing: {instruction}",
                        "Record the skip in task status and continue unless scenario rules say it is required.",
                    )
                )

        for key_file in repo.get("key_files") or []:
            if not (Path(repo_path) / key_file).exists():
                result["missing_key_files"].append(key_file)
                findings.append(
                    Finding(
                        "warning",
                        "missing_key_file",
                        f"Repo '{repo_key}' key file is missing: {key_file}",
                        "Confirm scenario.yaml is current before implementation.",
                    )
                )

        repo_results.append(result)

    status = (
        "ok"
        if validation["status"] == "ok"
        and not any(item.level == "error" for item in findings)
        else "error"
    )
    return {
        "status": status,
        "scenario": scenario,
        "generated_at": dt.datetime.now().isoformat(timespec="seconds"),
        "repos": repo_results,
        "validation_findings": validation["findings"],
        "findings": [item.to_dict() for item in findings],
    }


def render_preflight_status(report: dict[str, Any]) -> str:
    rows = []
    for repo in report["repos"]:
        rows.append(
            "| {key} | {branch_result} | {expected} | {actual} | {dirty} | {missing_i} | {missing_k} |".format(
                key=repo["key"],
                branch_result=repo["branch_result"],
                expected=repo.get("expected_branch") or "TBD",
                actual=repo.get("actual_branch") or "-",
                dirty="dirty" if repo.get("dirty") else "clean",
                missing_i=", ".join(repo.get("missing_instruction_sources") or [])
                or "-",
                missing_k=", ".join(repo.get("missing_key_files") or []) or "-",
            )
        )
    findings = report["findings"] or report["validation_findings"]
    finding_lines = (
        "\n".join(
            f"- [{item['level']}] {item['code']}: {item['message']}"
            for item in findings
        )
        or "None."
    )
    return f"""## Preflight Report

Generated: `{report["generated_at"]}`

| Repo | Branch Gate | Expected Branch | Actual Branch | Worktree | Missing Instruction Sources | Missing Key Files |
| --- | --- | --- | --- | --- | --- | --- |
{chr(10).join(rows)}

Findings:

{finding_lines}
"""


def render_preflight_validation(report: dict[str, Any]) -> str:
    rows = []
    for repo in report["repos"]:
        rows.append(
            f"| {repo['key']} | {repo.get('expected_branch') or 'TBD'} | {repo.get('actual_branch') or '-'} | {repo['branch_result']} |"
        )
    return f"""## Preflight Branch Gates

Generated: `{report["generated_at"]}`

| Repo | Expected Branch | Actual Branch | Result |
| --- | --- | --- | --- |
{chr(10).join(rows)}
"""


def collect_task_list(
    root: Path,
    scenario: str | None,
    incomplete_only: bool,
    all_modes: bool = False,
) -> dict[str, Any]:
    tasks_root = root / "tasks"
    tasks: list[dict[str, Any]] = []
    if not tasks_root.exists():
        return {
            "scenario": scenario,
            "filter": scenario or ("all" if all_modes else "free"),
            "tasks_root": str(tasks_root),
            "tasks": [],
        }

    for path in sorted(tasks_root.iterdir()):
        if not path.is_dir():
            continue
        status_file = path / "status.md"
        spec_file = path / "spec.md"
        status_text = (
            status_file.read_text(encoding="utf-8") if status_file.exists() else ""
        )
        mode = parse_task_mode(status_text)
        if scenario:
            if mode:
                if mode != f"scenario:{scenario}":
                    continue
            else:
                haystack = path.name
                for file_path in (status_file, spec_file):
                    if file_path.exists():
                        try:
                            haystack += "\n" + file_path.read_text(encoding="utf-8")
                        except UnicodeDecodeError:
                            pass
                if scenario not in haystack:
                    continue
        elif not all_modes and mode != "free":
            continue

        lowered = status_text.lower()
        state = (
            "complete"
            if "complete" in lowered and "not complete" not in lowered
            else "incomplete"
        )
        if "blocked" in lowered:
            state = "blocked"
        if incomplete_only and state == "complete":
            continue
        tasks.append(
            {
                "task_id": path.name,
                "path": str(path),
                "mode": mode,
                "state": state,
                "mtime": dt.datetime.fromtimestamp(path.stat().st_mtime).isoformat(
                    timespec="seconds"
                ),
                "has_spec": spec_file.exists(),
                "has_status": status_file.exists(),
                "has_decisions": (path / "decisions.md").exists(),
                "has_validation": (path / "validation.md").exists(),
            }
        )
    tasks.sort(key=lambda item: item["mtime"], reverse=True)
    return {
        "scenario": scenario,
        "filter": scenario or ("all" if all_modes else "free"),
        "tasks_root": str(tasks_root),
        "tasks": tasks,
    }


def check_matrix(
    root: Path, scenario: str, repo_filter: str | None = None
) -> dict[str, Any]:
    context = scenario_context(root, scenario)
    repos = []
    for repo in context["repos"]:
        if repo_filter and repo["key"] != repo_filter:
            continue
        repos.append(
            {
                "key": repo["key"],
                "path": repo.get("path"),
                "checks": repo.get("checks") or [],
            }
        )
    if repo_filter and not repos:
        raise HarnessError(
            f"Scenario '{scenario}' does not include repo '{repo_filter}'.",
            EXIT_VALIDATION,
        )
    return {"scenario": scenario, "repos": repos}


def run_checks(matrix: dict[str, Any], timeout_seconds: int) -> dict[str, Any]:
    results = []
    for repo in matrix["repos"]:
        repo_path = repo.get("path")
        for command in repo.get("checks") or []:
            started_at = dt.datetime.now()
            result: dict[str, Any] = {
                "repo": repo["key"],
                "path": repo_path,
                "command": command,
                "started_at": started_at.isoformat(timespec="seconds"),
                "exit_code": None,
                "result": "pending",
                "stdout_tail": "",
                "stderr_tail": "",
            }
            if not repo_path or not Path(repo_path).exists():
                result["result"] = "error"
                result["stderr_tail"] = f"Repo path is missing: {repo_path or 'TBD'}"
                results.append(result)
                continue
            try:
                process = subprocess.run(
                    command,
                    cwd=repo_path,
                    shell=True,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=timeout_seconds,
                    check=False,
                )
                result["exit_code"] = process.returncode
                result["result"] = "pass" if process.returncode == 0 else "fail"
                result["stdout_tail"] = process.stdout[-4000:]
                result["stderr_tail"] = process.stderr[-4000:]
            except subprocess.TimeoutExpired as exc:
                result["result"] = "timeout"
                result["stderr_tail"] = f"Timed out after {timeout_seconds}s"
                if exc.stdout:
                    result["stdout_tail"] = str(exc.stdout)[-4000:]
                if exc.stderr:
                    result["stderr_tail"] += "\n" + str(exc.stderr)[-4000:]
            result["finished_at"] = dt.datetime.now().isoformat(timespec="seconds")
            results.append(result)
    status = "ok" if all(item["result"] == "pass" for item in results) else "error"
    return {"scenario": matrix["scenario"], "status": status, "results": results}


def render_checks_validation(report: dict[str, Any]) -> str:
    rows = []
    for item in report["results"]:
        note = item["stderr_tail"].splitlines()[-1] if item.get("stderr_tail") else ""
        rows.append(
            f"| {item['repo']} | `{item['command']}` | {item['result']} | {note} |"
        )
    return f"""## Check Run

Generated: `{dt.datetime.now().isoformat(timespec="seconds")}`

| Repo | Command | Result | Notes |
| --- | --- | --- | --- |
{chr(10).join(rows) if rows else "| - | - | skipped | No checks declared. |"}
"""


def render_task_files(
    context: dict[str, Any],
    task_id: str,
    request: str,
    branches: dict[str, str],
) -> dict[str, str]:
    repos = context["repos"]
    order_lines = "\n".join(
        f"{index}. `{repo['key']}`" for index, repo in enumerate(repos, 1)
    )
    scope_lines = "\n".join(
        f"- `{repo['key']}`: {repo.get('description') or repo.get('role') or 'Scenario participant.'}"
        for repo in repos
    )

    step_rows = []
    step_index = 1
    for repo in repos:
        repo_key = repo["key"]
        step_rows.append(
            f"| {step_index} | {repo_key} | Inspect status, verify task branch, read instructions, and inspect key files | pending |"
        )
        step_index += 1
        step_rows.append(
            f"| {step_index} | {repo_key} | Enrich spec from key files before editing code | pending |"
        )
        step_index += 1
        step_rows.append(
            f"| {step_index} | {repo_key} | Implement repo-local change according to enriched spec | pending |"
        )
        step_index += 1
        step_rows.append(
            f"| {step_index} | {repo_key} | Run repo-local checks | pending |"
        )
        step_index += 1
    step_rows.append(
        f"| {step_index} | all | Update validation and final task status | pending |"
    )

    status_rows = "\n".join(
        f"| {repo['key']} | not started | {branches.get(repo['key']) or 'TBD'} | - | pending |"
        for repo in repos
    )
    branch_rows = "\n".join(
        f"| {repo['key']} | {branches.get(repo['key']) or 'TBD'} | TBD | pending |"
        for repo in repos
    )
    check_rows: list[str] = []
    for repo in repos:
        checks = repo.get("checks") or []
        if checks:
            for command in checks:
                check_rows.append(f"| {repo['key']} | `{command}` | pending |  |")
        else:
            check_rows.append(
                f"| {repo['key']} | TBD | pending | No checks declared in scenario.yaml. |"
            )

    details = []
    for repo in repos:
        details.append(
            "\n".join(
                [
                    f"### `{repo['key']}`",
                    "",
                    f"- Path: `{repo.get('path') or 'TBD'}`",
                    f"- Expected task branch: `{branches.get(repo['key']) or 'TBD'}`",
                    "- Instruction sources:",
                    markdown_list(repo.get("instruction_sources") or []),
                    "- Key files:",
                    markdown_list(repo.get("key_files") or []),
                    "- Outputs:",
                    markdown_outputs(repo.get("outputs") or []),
                    "- Dependencies:",
                    markdown_dependencies(repo.get("depends_on") or []),
                    "- Checks:",
                    markdown_list(repo.get("checks") or []),
                ]
            )
        )

    spec = f"""# Task Spec

## Task Mode

Mode: `scenario:{context["scenario"]}`

Selected via the Task Mode Selection Protocol: the request matches this declared scenario.

## Scenario

`{context["scenario"]}`

{context["description"]}

## User Request

{request or "TBD."}

## User Clarifications

Record any user clarification that affects goals, scope, implementation, validation, risks, or delivery order before continuing implementation.

- None yet.

## Scope

{scope_lines or "TBD."}

## Non-Goals

- Do not commit unless explicitly requested.
- Do not edit repositories outside the scenario order.
- Do not overwrite unrelated local changes.

## Assumptions

- The scenario configuration is authoritative for repository order.
- This task status is authoritative for expected task branches.
- Repository-local instructions remain authoritative inside each business repository.

## Scenario Order

{order_lines or "TBD."}

## Repository Context

{chr(10).join(details) if details else "TBD."}

## Key File Implementation Notes

Before editing code in each repository, read the repo-local instructions, inspect the scenario-defined key files, and update this section with concrete implementation notes, expected impact areas, risks, and validation focus. Implement according to the enriched spec. Any material deviation must be recorded in `decisions.md` and reflected back here before continuing.

- Pending key file review.

## Steps

| Step | Repo | Action | Status |
| --- | --- | --- | --- |
{chr(10).join(step_rows)}

## Open Questions

None.
"""

    status = f"""# Status

Mode: `scenario:{context["scenario"]}`

Scenario: `{context["scenario"]}`

Task ID: `{task_id}`

## Repositories

| Repo | Status | Expected Branch | Actual Branch | Checks |
| --- | --- | --- | --- | --- |
{status_rows}

## Current Step

Task initialized. Next step: run preflight before entering business repositories.

## Blockers

None.

## Notes

- Generated by `bin/repomesh init-task`.
"""

    validation = f"""# Validation Report

## Branch Gates

| Repo | Expected Branch | Actual Branch | Result |
| --- | --- | --- | --- |
{branch_rows}

## Repo-Local Checks

| Repo | Command | Result | Notes |
| --- | --- | --- | --- |
{chr(10).join(check_rows)}

## Known Failures

None.

## Residual Risk

TBD after checks run.
"""

    decisions = f"""# Decisions

## Accepted

| Date | Decision | Reason | Impact |
| --- | --- | --- | --- |

## Rejected

| Date | Option | Reason Rejected |
| --- | --- | --- |

## Notes

- Generated by `bin/repomesh init-task`.
"""

    return {
        "spec.md": spec,
        "status.md": status,
        "validation.md": validation,
        "decisions.md": decisions,
    }


def render_free_task_files(
    task_id: str,
    request: str,
    shared_branch: str,
    overrides: dict[str, str],
) -> dict[str, str]:
    override_lines = (
        "\n".join(f"- `{repo}` = `{branch}`" for repo, branch in sorted(overrides.items()))
        or "- none"
    )

    spec = f"""# Task Spec

## Task Mode

Mode: `free`

Selection reason: TBD — record why this request runs as a free task (no matching scenario, explicitly one-off, or user choice per the Task Mode Selection Protocol).

## User Request

{request or "TBD."}

## User Clarifications

Record any user clarification that affects goals, scope, implementation, validation, risks, or delivery order before continuing implementation.

- None yet.

## Scope

TBD — determined by the Planning Pass after candidate scoping.

## Non-Goals

- Do not commit unless explicitly requested.
- Do not edit repositories outside the task-declared topology.
- Do not overwrite unrelated local changes.

## Assumptions

- `repos.yaml` is the workspace registry for repo paths, instruction sources, key files, and checks.
- This task's status.md is authoritative for expected task branches and declared execution order.
- Repository-local instructions remain authoritative inside each business repository.

## Task-Declared Topology

TBD — after the Planning Pass, replace with the affected repos in declared execution order (must match the status.md per-repo table row order):

1. `TBD`

## Candidate Scoping

TBD — record the candidate repo set and each candidate's provenance (user-named, baseline-graph edge evidence, or workspace scan), plus exclusion reasons for candidates not selected. Direction rule: when changing repo X, always check X's in-edge neighbors (repos consuming X's outputs); include out-edge upstreams only when the request itself requires upstream changes; never traverse out-edges only. Single-repo adjudication additionally requires the workspace-level reverse lookup over all registered repos (see AGENTS.md Free Task Protocol).

## Dependency Readiness

TBD — initialize from the task-level dependency edges produced by the Planning Pass.

## Repository Context

TBD — per-repo entries (path, instruction sources, key files, checks) resolved from repos.yaml by the Planning Pass.

## Key File Implementation Notes

Before editing code in each repository, enrich this section with concrete implementation notes, expected impact areas, risks, and validation focus.

- Pending key file review.

## Steps

| Step | Repo | Action | Status |
| --- | --- | --- | --- |
| 1 | all | Candidate scoping + Planning Pass + repo-local spec entries | pending |
| 2 | all | Spec Review Gate | pending |
| 3 | per repo | Runtime reconciliation, implement, checks (declared order) | pending |

## Open Questions

None.
"""

    status = f"""# Status

Mode: `free`

Scenario: none (free task)

Task ID: `{task_id}`

Default expected branch: `{shared_branch}`

Per-repo branch overrides:
{override_lines}

## Repositories

The Planning Pass fills this table; row order is the task-declared execution order consumed by `run`.

| Repo | Status | Expected Branch | Actual Branch | Checks |
| --- | --- | --- | --- | --- |

## Current Step

Task initialized. Next step: candidate scoping from repos.yaml, then the Planning Pass before entering business repositories.

## Dependency Readiness

TBD — initialize from the task-level dependency edges produced by the Planning Pass.

## Blockers

None.

## Notes

- Generated by `bin/repomesh init-task --free`.
- Repos without declared checks in repos.yaml must record a validation gap in validation.md.
"""

    validation = f"""# Validation Report

## Branch Gates

Default expected branch: `{shared_branch}` (per-repo rows are added by the Planning Pass).

| Repo | Expected Branch | Actual Branch | Result |
| --- | --- | --- | --- |

## Repo-Local Checks

| Repo | Command | Result | Notes |
| --- | --- | --- | --- |
| TBD | TBD | pending | Checks come from repos.yaml; repos without declared checks must record a validation gap. |

## Known Failures

None.

## Residual Risk

TBD after checks run.
"""

    decisions = f"""# Decisions

## Accepted

| Date | Decision | Reason | Impact |
| --- | --- | --- | --- |

## Rejected

| Date | Option | Reason Rejected |
| --- | --- | --- |

## Notes

- Generated by `bin/repomesh init-task --free`.
"""

    return {
        "spec.md": spec,
        "status.md": status,
        "validation.md": validation,
        "decisions.md": decisions,
    }


def print_text_report(report: dict[str, Any]) -> None:
    print(f"scenario: {report['scenario']}")
    print(f"status: {report['status']}")
    print(f"scenario_file: {report['scenario_file']}")
    print(f"scenario_readme: {report['scenario_readme']}")
    print("")
    print("repos:")
    for repo in report["repos"]:
        line = f"- {repo['key']}"
        if repo.get("path"):
            line += f" path={repo['path']}"
        if repo.get("config") == "missing":
            line += " config=missing"
        print(line)
    print("")
    if report["findings"]:
        print("findings:")
        for finding in report["findings"]:
            print(f"- [{finding['level']}] {finding['code']}: {finding['message']}")
            if finding.get("fix"):
                print(f"  fix: {finding['fix']}")
    else:
        print("findings: none")


def print_preflight_report(report: dict[str, Any]) -> None:
    print(f"scenario: {report['scenario']}")
    print(f"status: {report['status']}")
    print(f"generated_at: {report['generated_at']}")
    print("")
    print("repos:")
    for repo in report["repos"]:
        print(
            "- {key} branch={branch_result} expected={expected} actual={actual} worktree={dirty}".format(
                key=repo["key"],
                branch_result=repo["branch_result"],
                expected=repo.get("expected_branch") or "TBD",
                actual=repo.get("actual_branch") or "-",
                dirty="dirty" if repo.get("dirty") else "clean",
            )
        )
        if repo.get("missing_instruction_sources"):
            print(
                f"  missing_instruction_sources: {', '.join(repo['missing_instruction_sources'])}"
            )
        if repo.get("missing_key_files"):
            print(f"  missing_key_files: {', '.join(repo['missing_key_files'])}")
        if repo.get("errors"):
            print(f"  errors: {'; '.join(repo['errors'])}")
    print("")
    findings = report["findings"] or report["validation_findings"]
    if findings:
        print("findings:")
        for finding in findings:
            print(f"- [{finding['level']}] {finding['code']}: {finding['message']}")
            if finding.get("fix"):
                print(f"  fix: {finding['fix']}")
    else:
        print("findings: none")


def print_plan_report(report: dict[str, Any]) -> None:
    print(f"scenario: {report['scenario']}")
    print(f"scenario_dir: {report['scenario_dir']}")
    print("")
    print("order:")
    for index, repo in enumerate(report["repos"], 1):
        print(f"{index}. {repo['key']}")
        print(f"   path: {repo.get('path') or 'TBD'}")
        print(
            f"   outputs: {', '.join(output.get('id', 'TBD') for output in repo.get('outputs') or [] if isinstance(output, dict)) or '-'}"
        )
        print(
            "   depends_on: "
            + (
                ", ".join(
                    f"{dependency.get('repo', 'TBD')}:{dependency.get('output', 'TBD')}"
                    for dependency in repo.get("depends_on") or []
                    if isinstance(dependency, dict)
                )
                or "-"
            )
        )
        print(
            f"   instruction_sources: {', '.join(repo.get('instruction_sources') or []) or '-'}"
        )
        print(f"   key_files: {', '.join(repo.get('key_files') or []) or '-'}")
        print(f"   checks: {', '.join(repo.get('checks') or []) or '-'}")


def print_task_list(report: dict[str, Any]) -> None:
    if report.get("scenario"):
        print(f"scenario: {report['scenario']}")
    else:
        print(f"filter: {report.get('filter') or 'free'}")
    print(f"tasks_root: {report['tasks_root']}")
    if not report["tasks"]:
        print("tasks: none")
        return
    print("tasks:")
    for task in report["tasks"]:
        mode = task.get("mode") or "-"
        print(
            f"- {task['task_id']} mode={mode} state={task['state']} mtime={task['mtime']} path={task['path']}"
        )


def print_check_matrix(matrix: dict[str, Any]) -> None:
    print(f"scenario: {matrix['scenario']}")
    print("checks:")
    for repo in matrix["repos"]:
        if repo.get("checks"):
            for command in repo["checks"]:
                print(
                    f"- repo={repo['key']} path={repo.get('path') or 'TBD'} command={command}"
                )
        else:
            print(
                f"- repo={repo['key']} path={repo.get('path') or 'TBD'} command=<none>"
            )


def print_check_results(report: dict[str, Any]) -> None:
    print(f"scenario: {report['scenario']}")
    print(f"status: {report['status']}")
    for item in report["results"]:
        print(
            f"- repo={item['repo']} result={item['result']} exit_code={item.get('exit_code')} command={item['command']}"
        )
        if item.get("stderr_tail"):
            print(f"  stderr_tail: {item['stderr_tail'].splitlines()[-1]}")


def print_registry_report(report: dict[str, Any]) -> None:
    print(f"registry_file: {report['registry_file']}")
    print(f"status: {report['status']}")
    print("")
    print("repos:")
    for repo in report["repos"]:
        line = f"- {repo['key']}"
        if repo.get("path"):
            line += f" path={repo['path']}"
        print(line)
    print("")
    if report.get("edges"):
        print("edges:")
        for edge in report["edges"]:
            print(f"- {edge.get('from') or 'TBD'} -> {edge.get('to') or 'TBD'}")
        print("")
    if report.get("scenarios"):
        print("scenario_crosscheck:")
        for summary in report["scenarios"]:
            line = f"- {summary['scenario']}: ok"
            if summary["missing_repos"]:
                line = (
                    f"- {summary['scenario']}: missing repos "
                    + ", ".join(summary["missing_repos"])
                )
            if summary["divergent_repos"]:
                diverged = "; ".join(
                    f"{key} ({'/'.join(fields)})"
                    for key, fields in sorted(summary["divergent_repos"].items())
                )
                line += f"; divergent {diverged}"
            print(line)
        print("")
    if report["findings"]:
        print("findings:")
        for finding in report["findings"]:
            print(f"- [{finding['level']}] {finding['code']}: {finding['message']}")
            if finding.get("fix"):
                print(f"  fix: {finding['fix']}")
    else:
        print("findings: none")


def cmd_validate(args: argparse.Namespace) -> int:
    root = harness_root()
    report = validate_scenario(root, args.scenario)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text_report(report)
    return EXIT_OK if report["status"] == "ok" else EXIT_VALIDATION


def cmd_validate_registry(args: argparse.Namespace) -> int:
    root = harness_root()
    report = validate_registry(root)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_registry_report(report)
    return EXIT_OK if report["status"] == "ok" else EXIT_VALIDATION


def cmd_init_task(args: argparse.Namespace) -> int:
    root = harness_root()

    if not args.free and not args.scenario:
        raise HarnessError(
            "init-task requires a scenario, or pass --free for a free task.", EXIT_USAGE
        )

    mode_value: str
    scenario_label: str | None = None
    if args.free:
        if args.scenario and args.task_id:
            raise HarnessError(
                "init-task --free takes exactly one task id argument.", EXIT_USAGE
            )
        # With two optional positionals argparse fills the scenario slot first,
        # so a single bare argument is the task id whichever slot it landed in.
        free_task_id = args.task_id or args.scenario
        if not free_task_id:
            raise HarnessError(
                "init-task --free requires a task id such as 2026-08-23-short-topic.",
                EXIT_USAGE,
            )
        validation = validate_registry(root)
        if validation["status"] != "ok" and not args.allow_invalid:
            result = {
                "status": "error",
                "scenario": None,
                "mode": "free",
                "message": "Registry validation failed; task files were not created.",
                "fix": "Fix validate-registry findings or pass --allow-invalid to create recovery files anyway.",
                "findings": validation["findings"],
            }
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(
                    "error: Registry validation failed; task files were not created.",
                    file=sys.stderr,
                )
                print(
                    "fix: Fix validate-registry findings or pass --allow-invalid to create recovery files anyway.",
                    file=sys.stderr,
                )
            return EXIT_VALIDATION
        task_id = free_task_id
        shared_branch = args.branch or f"scenario/{task_id}"
        overrides = parse_branch_overrides(args.repo_branch)
        task_dir = root / "tasks" / task_id
        files = render_free_task_files(task_id, args.request or "", shared_branch, overrides)
        mode_value = "free"
    else:
        validation = validate_scenario(root, args.scenario)
        if validation["status"] != "ok" and not args.allow_invalid:
            result = {
                "status": "error",
                "scenario": args.scenario,
                "mode": f"scenario:{args.scenario}",
                "message": "Scenario validation failed; task files were not created.",
                "fix": "Fix validation findings or pass --allow-invalid to create recovery files anyway.",
                "findings": validation["findings"],
            }
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(
                    "error: Scenario validation failed; task files were not created.",
                    file=sys.stderr,
                )
                print(
                    "fix: Fix validation findings or pass --allow-invalid to create recovery files anyway.",
                    file=sys.stderr,
                )
            return EXIT_VALIDATION
        context = scenario_context(root, args.scenario)
        task_id = args.task_id or f"{dt.date.today().isoformat()}-{args.scenario}"
        shared_branch = args.branch or f"scenario/{task_id}"
        branches = task_branch_map(
            context, shared_branch, parse_branch_overrides(args.repo_branch)
        )
        task_dir = root / "tasks" / task_id
        files = render_task_files(context, task_id, args.request or "", branches)
        mode_value = f"scenario:{args.scenario}"
        scenario_label = args.scenario

    created: list[str] = []
    existing: list[str] = []
    if not args.dry_run:
        task_dir.mkdir(parents=True, exist_ok=True)
        for name, content in files.items():
            path = task_dir / name
            if path.exists():
                existing.append(str(path))
                continue
            path.write_text(content, encoding="utf-8")
            created.append(str(path))
    else:
        created = [str(task_dir / name) for name in files]

    status = (
        "created"
        if created and not existing
        else "exists"
        if existing and not created
        else "partial"
    )
    result = {
        "status": status,
        "scenario": scenario_label,
        "mode": mode_value,
        "task_id": task_id,
        "task_dir": str(task_dir),
        "created": created,
        "existing": existing,
        "dry_run": args.dry_run,
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"status: {status}")
        print(f"mode: {mode_value}")
        print(f"task_dir: {task_dir}")
        if created:
            print("created:")
            for path in created:
                print(f"- {path}")
        if existing:
            print("existing:")
            for path in existing:
                print(f"- {path}")
            print("note: existing task files were not overwritten")
    return EXIT_OK


def cmd_preflight(args: argparse.Namespace) -> int:
    root = harness_root()

    free_mode = False
    label = args.scenario
    context: dict[str, Any] | None = None
    validation: dict[str, Any] | None = None
    if not args.scenario:
        if not args.task:
            raise HarnessError(
                "preflight requires a scenario, or --task for a task-driven preflight "
                "(free tasks: repo set from the task declaration + registry).",
                EXIT_USAGE,
            )
        mode_task_dir = resolve_task_dir(root, args.task)
        kind, name = read_task_mode(mode_task_dir)
        if kind == "free":
            free_mode = True
            label = "free"
            validation = validate_registry(root)
            context = free_task_context(root, mode_task_dir)
        elif kind == "scenario" and name:
            label = name
        else:
            raise HarnessError(
                "Task does not record a usable `mode:` or `Scenario:` line in "
                "status.md; pass a scenario explicitly.",
                EXIT_USAGE,
            )

    task_dir = resolve_task_dir(root, args.task) if args.task else None
    expected_branches = read_task_branches(task_dir) if task_dir else {}
    if free_mode and task_dir is not None:
        defaults = read_task_branch_defaults(task_dir)
        for repo in context["repos"]:
            if not expected_branches.get(repo["key"]):
                fallback = defaults["overrides"].get(repo["key"]) or defaults["default"]
                if fallback:
                    expected_branches[repo["key"]] = fallback
    expected_branches.update(parse_branch_overrides(args.repo_branch))
    if args.branch:
        map_context = context if context is not None else scenario_context(root, label)
        expected_branches = task_branch_map(map_context, args.branch, expected_branches)
    report = collect_preflight(
        root,
        label,
        expected_branches,
        context=context,
        validation=validation,
        path_source="repos.yaml" if free_mode else "scenario.yaml",
    )

    if task_dir and not args.no_write:
        if not task_dir.exists():
            raise HarnessError(
                f"Task directory does not exist: {task_dir}",
                EXIT_VALIDATION,
            )
        upsert_marked_block(
            task_dir / "status.md", "preflight-status", render_preflight_status(report)
        )
        upsert_marked_block(
            task_dir / "validation.md",
            "preflight-validation",
            render_preflight_validation(report),
        )

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_preflight_report(report)
        if task_dir and not args.no_write:
            print("")
            print(f"updated: {task_dir / 'status.md'}")
            print(f"updated: {task_dir / 'validation.md'}")
    return EXIT_OK if report["status"] == "ok" else EXIT_VALIDATION


def cmd_plan(args: argparse.Namespace) -> int:
    root = harness_root()
    report = scenario_context(root, args.scenario)
    validation = validate_scenario(root, args.scenario)
    report["validation_status"] = validation["status"]
    report["validation_findings"] = validation["findings"]
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_plan_report(report)
        if validation["status"] != "ok":
            print("")
            print("validation_findings:")
            for finding in validation["findings"]:
                print(f"- [{finding['level']}] {finding['code']}: {finding['message']}")
    return EXIT_OK if validation["status"] == "ok" else EXIT_VALIDATION


def cmd_list_tasks(args: argparse.Namespace) -> int:
    root = harness_root()
    report = collect_task_list(root, args.scenario, args.incomplete_only, args.all)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_task_list(report)
    return EXIT_OK


def checks_matrix_from_context(
    context: dict[str, Any], repo_filter: str | None = None
) -> dict[str, Any]:
    repos = []
    for repo in context["repos"]:
        if repo_filter and repo["key"] != repo_filter:
            continue
        repos.append(
            {
                "key": repo["key"],
                "path": repo.get("path"),
                "checks": repo.get("checks") or [],
            }
        )
    if repo_filter and not repos:
        raise HarnessError(
            f"Task-declared repo set does not include repo '{repo_filter}'.",
            EXIT_VALIDATION,
        )
    return {"scenario": context["scenario"], "repos": repos}


def cmd_checks(args: argparse.Namespace) -> int:
    root = harness_root()
    if args.scenario:
        matrix = check_matrix(root, args.scenario, args.repo)
    else:
        if not args.task:
            raise HarnessError(
                "checks requires a scenario, or --task for a task-driven check "
                "source (free tasks: checks from the registry).",
                EXIT_USAGE,
            )
        task_dir_probe = resolve_task_dir(root, args.task)
        kind, name = read_task_mode(task_dir_probe)
        if kind == "free":
            matrix = checks_matrix_from_context(
                free_task_context(root, task_dir_probe), args.repo
            )
        elif kind == "scenario" and name:
            matrix = check_matrix(root, name, args.repo)
        else:
            raise HarnessError(
                "Task does not record a usable `mode:` or `Scenario:` line in "
                "status.md; pass a scenario explicitly.",
                EXIT_USAGE,
            )
    if not args.run:
        if args.json:
            print(json.dumps(matrix, indent=2, sort_keys=True))
        else:
            print_check_matrix(matrix)
        return EXIT_OK

    report = run_checks(matrix, args.timeout_seconds)
    task_dir = resolve_task_dir(root, args.task) if args.task else None
    if task_dir:
        if not task_dir.exists():
            raise HarnessError(
                f"Task directory does not exist: {task_dir}", EXIT_VALIDATION
            )
        upsert_marked_block(
            task_dir / "validation.md", "check-run", render_checks_validation(report)
        )
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_check_results(report)
        if task_dir:
            print(f"updated: {task_dir / 'validation.md'}")
    return EXIT_OK if report["status"] == "ok" else EXIT_VALIDATION


STATUS_STEP_RANK = {
    "task_created": 0,
    "scenario_invalid": 1,
    "scenario_validated": 2,
    "preflight_complete": 3,
    "branch_preparation_in_progress": 4,
    "branch_preparation_complete": 5,
    "planning_in_progress": 6,
    "planning_blocked": 6,
    "planning_complete": 7,
    "spec_review_pending": 8,
    "spec_review_approved": 9,
    "replanning_required": 8,
    "replanning_in_progress": 8,
    "replanning_complete": 8,
    "complete": 11,
}
REPLANNING_STEPS = {
    "replanning_required",
    "replanning_in_progress",
    "replanning_complete",
}


def status_step_rank(step: str | None) -> int | None:
    if step is None:
        return None
    if step.startswith(("implementing:", "validating:", "repo_complete:")):
        return 10
    return STATUS_STEP_RANK.get(step)


def read_current_step(status_text: str) -> str | None:
    for line in status_text.splitlines():
        match = re.search(r"current step\s*[:\-]\s*`?([a-z_:]+)`?", line, re.IGNORECASE)
        if match:
            return match.group(1)
    return None


def gate_section_ready(status_text: str, heading: str, ready_words: tuple[str, ...]) -> bool:
    pattern = re.compile(rf"^#{1,6}\s*{heading}\b", re.IGNORECASE)
    lines = status_text.splitlines()
    for index, line in enumerate(lines):
        if not pattern.match(line.strip()):
            continue
        section: list[str] = []
        for follow in lines[index + 1 :]:
            if re.match(r"^#{1,6}\s+", follow.strip()):
                break
            section.append(follow)
        text = "\n".join(section).lower()
        return any(word in text for word in ready_words)
    return False


def task_gates_ready(task_dir: Path) -> dict[str, Any]:
    """Read Planning Gate and Spec Review Gate state from status.md.

    Both signals are honored: the protocol `current step` line and explicit
    gate sections. `blocked` carries no rank, so it falls back to sections.
    Replanning states require a fresh spec review per the Replanning Protocol.
    """

    status_file = task_dir / "status.md"
    status_text = status_file.read_text(encoding="utf-8") if status_file.exists() else ""
    if not status_text.strip():
        return {
            "planning_gate": "missing",
            "spec_review_gate": "missing",
            "current_step": None,
        }

    current_step = read_current_step(status_text)
    rank = status_step_rank(current_step)

    planning_section = gate_section_ready(
        status_text, "Planning Gate", ("planning_complete", "complete: yes", "complete.")
    )
    spec_section = gate_section_ready(
        status_text,
        "Spec Review Gate",
        ("spec_review_approved", "approved", "skipped"),
    )

    planning_ready = planning_section or (rank is not None and rank >= 7)
    if rank is None or current_step == "blocked":
        spec_ready = spec_section
    else:
        spec_ready = spec_section or (
            rank >= 9 and current_step not in REPLANNING_STEPS
        )

    return {
        "planning_gate": "ready" if planning_ready else "missing",
        "spec_review_gate": "ready" if spec_ready else "missing",
        "current_step": current_step,
    }


# --- check-task: structural lint of task files against the templates/ skeleton ---

TASK_FILE_ORDER = ("spec.md", "status.md", "validation.md", "decisions.md")

TEMPLATE_FILE_MAP = {
    "spec.md": "spec.md",
    "status.md": "task-status.md",
    "validation.md": "validation-report.md",
    "decisions.md": "decisions.md",
}

# Mode-ownership mapping stays in command code on purpose (it must not
# propagate from templates/): template sections that only scenario tasks
# require, and beyond-baseline sections that only free tasks require.
SPEC_SCENARIO_ONLY_SECTIONS = ("Scenario", "Scenario Order")
SPEC_FREE_ONLY_SECTIONS = ("Task-Declared Topology", "Candidate Scoping")

GATE_SECTION_NAMES = ("Planning Gate", "Spec Review Gate")

REPO_TABLE_COLUMNS = 5  # Repo | Status | Expected Branch | Actual Branch | Checks

STATUS_STEP_VOCABULARY = frozenset(STATUS_STEP_RANK) | {"blocked"}

SECTION_HEADING_RE = re.compile(r"^##\s+(.+?)\s*$")
LINT_MODE_LINE_RE = re.compile(r"^mode\s*[:\-]\s*(.+?)\s*$", re.IGNORECASE | re.MULTILINE)
LINT_SCENARIO_LINE_RE = re.compile(
    r"^scenario\s*[:\-]\s*`?([A-Za-z0-9_-]+)`?", re.IGNORECASE | re.MULTILINE
)


def status_step_valid(step: str) -> bool:
    if step in STATUS_STEP_VOCABULARY:
        return True
    return bool(re.match(r"^(implementing|validating|repo_complete):\S+", step))


def extract_markdown_sections(text: str) -> list[str]:
    sections = []
    for line in text.splitlines():
        match = SECTION_HEADING_RE.match(line.strip())
        if match:
            sections.append(match.group(1).strip())
    return sections


def extract_section_body(text: str, heading: str) -> str | None:
    """Body of the first section whose heading matches, or None when absent."""

    heading_re = re.compile(
        rf"^#{{1,6}}\s*{re.escape(heading)}\b\s*$", re.IGNORECASE
    )
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if not heading_re.match(line.strip()):
            continue
        section: list[str] = []
        for follow in lines[index + 1 :]:
            if re.match(r"^#{1,6}\s+", follow.strip()):
                break
            section.append(follow)
        return "\n".join(section)
    return None


def template_section_baseline(root: Path, findings: list[Finding]) -> dict[str, list[str]]:
    """Extract the common-core section baseline from templates/ at runtime.

    templates/ is the declarative schema source for task files: adding or
    removing a template section changes what check-task requires on its next
    run, with no code change.
    """

    templates_dir = root / "templates"
    if not templates_dir.is_dir():
        findings.append(
            Finding(
                "error",
                "templates_missing",
                f"Templates directory is missing: {templates_dir}",
                "check-task derives its section baseline from templates/; restore the directory.",
            )
        )
        return {}
    baseline: dict[str, list[str]] = {}
    for task_name in TASK_FILE_ORDER:
        template_path = templates_dir / TEMPLATE_FILE_MAP[task_name]
        if not template_path.is_file():
            findings.append(
                Finding(
                    "error",
                    "template_file_missing",
                    f"Template file is missing: {template_path}",
                    f"Restore templates/{TEMPLATE_FILE_MAP[task_name]}; it defines the required sections of {task_name}.",
                )
            )
            continue
        baseline[task_name] = extract_markdown_sections(
            template_path.read_text(encoding="utf-8")
        )
    return baseline


def classify_task_mode(status_text: str) -> tuple[str | None, str | None, str | None]:
    """Lint view of the task mode: (kind, scenario name, raw mode value).

    Unlike read_task_mode, an unparseable Mode value is surfaced as kind
    'invalid' instead of silently falling back, so check-task can grade it as
    a shape error. kind is 'free', 'scenario', 'invalid', or None.
    """

    text = strip_marked_blocks(status_text)
    raw_value: str | None = None
    match = LINT_MODE_LINE_RE.search(text)
    if match:
        candidate = match.group(1).strip().strip("`").strip()
        if candidate.startswith("<!--"):
            candidate = ""  # unfilled template placeholder
        raw_value = candidate or None
    if raw_value:
        if raw_value.lower() == "free":
            return ("free", None, raw_value)
        scenario_match = re.match(r"^scenario:([A-Za-z0-9_-]+)$", raw_value, re.IGNORECASE)
        if scenario_match:
            return ("scenario", scenario_match.group(1), raw_value)
        return ("invalid", None, raw_value)
    legacy = LINT_SCENARIO_LINE_RE.search(text)
    if legacy and legacy.group(1).lower() != "none":
        return ("scenario", legacy.group(1), None)
    return (None, None, None)


def split_table_row(line: str) -> list[str]:
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


def is_separator_row(cells: list[str]) -> bool:
    return bool(cells) and all(re.fullmatch(r":?-+:?", cell) for cell in cells)


def check_task_structure(root: Path, task_dir: Path) -> dict[str, Any]:
    findings: list[Finding] = []
    baseline = template_section_baseline(root, findings)

    texts: dict[str, str] = {}
    file_reports: list[dict[str, Any]] = []
    for name in TASK_FILE_ORDER:
        path = task_dir / name
        entry: dict[str, Any] = {"name": name}
        if path.is_file():
            try:
                texts[name] = path.read_text(encoding="utf-8")
                entry["exists"] = True
            except (OSError, UnicodeDecodeError) as exc:
                entry["exists"] = False
                findings.append(
                    Finding(
                        "error",
                        "task_file_unreadable",
                        f"Task file {name} could not be read: {exc}",
                        "Restore the file or rerun init-task without overwriting existing files.",
                    )
                )
        else:
            entry["exists"] = False
            findings.append(
                Finding(
                    "error",
                    "missing_task_file",
                    f"Required task file is missing: {path}",
                    f"Create {name} from templates/{TEMPLATE_FILE_MAP[name]} or rerun init-task.",
                )
            )
        file_reports.append(entry)

    status_text = texts.get("status.md", "")
    status_authored = strip_marked_blocks(status_text) if status_text else ""

    kind, scenario_name, raw_mode = classify_task_mode(status_text)
    mode_label: str | None = None
    if kind == "free":
        mode_label = "free"
    elif kind == "scenario":
        mode_label = f"scenario:{scenario_name}"
    elif kind == "invalid":
        findings.append(
            Finding(
                "error",
                "mode_invalid",
                f"Mode line value is neither `free` nor `scenario:<name>`: {raw_mode!r}.",
                "Set Mode: `free` or Mode: `scenario:<scenario>` in status.md.",
            )
        )
    if raw_mode is None:
        # No Mode line at all: legacy task, interpreted via the Scenario: line
        # (or plain scenario shape when that is absent too).
        findings.append(
            Finding(
                "warning",
                "mode_missing",
                "status.md records no Mode line; interpreting the task as a scenario task (legacy compatibility).",
                "Add Mode: `scenario:<name>` or Mode: `free` to status.md.",
            )
        )

    scenario_file: Path | None = None
    if kind == "scenario" and scenario_name:
        scenario_file = root / "scenarios" / scenario_name / "scenario.yaml"
        if not scenario_file.is_file():
            findings.append(
                Finding(
                    "error",
                    "mode_scenario_unknown",
                    f"Mode references scenario '{scenario_name}' but {scenario_file} does not exist.",
                    "Fix the Mode line or create the scenario directory.",
                )
            )

    # --- required sections (baseline from templates/, adjusted by mode) ---
    for entry in file_reports:
        name = entry["name"]
        required = list(baseline.get(name, []))
        if name == "spec.md" and kind == "free":
            required = [
                section
                for section in required
                if section not in SPEC_SCENARIO_ONLY_SECTIONS
            ] + list(SPEC_FREE_ONLY_SECTIONS)
        entry["sections_required"] = len(required)
        if name not in texts:
            entry["sections_missing"] = required
            continue
        present = set(extract_markdown_sections(strip_marked_blocks(texts[name])))
        missing = [section for section in required if section not in present]
        entry["sections_missing"] = missing
        for section in missing:
            findings.append(
                Finding(
                    "error",
                    "missing_section",
                    f"{name} is missing required section '{section}'.",
                    f"Add a '## {section}' section; templates/{TEMPLATE_FILE_MAP[name]} is the schema source.",
                )
            )

    # --- status.md: current step, gates sections, per-repo table ---
    current_step: str | None = None
    gates: dict[str, str] = {heading: "missing" for heading in GATE_SECTION_NAMES}
    repo_rows: list[dict[str, Any]] = []

    if status_text:
        current_step = read_current_step(status_authored)
        if current_step is None:
            findings.append(
                Finding(
                    "warning",
                    "current_step_missing",
                    "status.md does not record a `current step:` line yet.",
                    "Set current step to a value from the AGENTS.md Status Step Vocabulary.",
                )
            )
        elif not status_step_valid(current_step):
            findings.append(
                Finding(
                    "error",
                    "current_step_invalid",
                    f"current step '{current_step}' is not in the Status Step Vocabulary.",
                    "Use a step name from the AGENTS.md Status Step Vocabulary.",
                )
            )

        for heading in GATE_SECTION_NAMES:
            if extract_section_body(status_authored, heading) is not None:
                gates[heading] = "present"
            else:
                findings.append(
                    Finding(
                        "warning",
                        "gate_section_missing",
                        f"status.md has no '{heading}' section yet.",
                        f"Add a '## {heading}' section once the gate is decided (AGENTS.md requires it in status.md).",
                    )
                )

        repositories_body = extract_section_body(status_authored, "Repositories")
        if repositories_body is not None:
            table_rows = [
                split_table_row(line)
                for line in repositories_body.splitlines()
                if line.strip().startswith("|")
            ]
            if not table_rows:
                findings.append(
                    Finding(
                        "error",
                        "repo_table_missing",
                        "The Repositories section of status.md contains no table.",
                        "Add the per-repo status table with the columns from templates/task-status.md.",
                    )
                )
            else:
                header = table_rows[0]
                if len(header) != REPO_TABLE_COLUMNS:
                    findings.append(
                        Finding(
                            "error",
                            "table_header_columns",
                            f"Per-repo table header has {len(header)} cells, expected {REPO_TABLE_COLUMNS} (Repo | Status | Expected Branch | Actual Branch | Checks).",
                            "Use the header from templates/task-status.md.",
                        )
                    )
                for row in table_rows[1:]:
                    if len(row) != len(header):
                        findings.append(
                            Finding(
                                "error",
                                "table_row_misaligned",
                                f"Per-repo table row has {len(row)} cells while the header has {len(header)}: {' | '.join(row)}.",
                                "Match the column count of the table header.",
                            )
                        )
                data_rows = [row for row in table_rows[1:] if not is_separator_row(row)]
                if not data_rows:
                    findings.append(
                        Finding(
                            "warning",
                            "repo_table_empty",
                            "The per-repo table has no data rows yet.",
                            "The Planning Pass fills the table; row order is the declared execution order.",
                        )
                    )
                seen_keys: set[str] = set()
                for row in data_rows:
                    repo_key = re.sub(r"^`|`$", "", row[0]) if row else ""
                    if not repo_key:
                        findings.append(
                            Finding(
                                "error",
                                "repo_cell_empty",
                                "Per-repo table row has an empty repo cell.",
                                "Set the repo key in the first column.",
                            )
                        )
                        continue
                    if repo_key in seen_keys:
                        findings.append(
                            Finding(
                                "error",
                                "repo_row_duplicate",
                                f"Per-repo table declares repo '{repo_key}' more than once.",
                                "Keep one row per repo; row order is the execution order.",
                            )
                        )
                        continue
                    seen_keys.add(repo_key)
                    branch = row[2] if len(row) > 2 else ""
                    if not branch or branch in {"-", "TBD"}:
                        findings.append(
                            Finding(
                                "warning",
                                "branch_unspecified",
                                f"Repo '{repo_key}' has no expected branch recorded yet.",
                                "The Planning Pass materializes per-repo branches from the task defaults.",
                            )
                        )
                    repo_rows.append(
                        {"key": repo_key, "branch": branch or None}
                    )

    # --- mode-aware: table rows must resolve to the mode's declaration layer ---
    source_label: str | None = None
    source_keys: set[str] | None = None
    if kind == "free":
        registry_file = root / REGISTRY_FILE_NAME
        if registry_file.is_file():
            try:
                source_keys = set(registry_repos(load_registry(root)))
                source_label = "repos.yaml"
            except HarnessError as exc:
                findings.append(
                    Finding(
                        "error",
                        "repo_source_unreadable",
                        f"repos.yaml could not be read to resolve table rows: {exc}",
                        "Fix repos.yaml (validate-registry reports details).",
                    )
                )
        else:
            findings.append(
                Finding(
                    "error",
                    "repo_source_missing",
                    f"Free task table rows must resolve against repos.yaml, which is missing: {registry_file}.",
                    "Create repos.yaml or fix the Mode line.",
                )
            )
    elif kind == "scenario" and scenario_file is not None and scenario_file.is_file():
        try:
            _, scenario_data = load_scenario(root, scenario_name or "")
            source_keys = set(scenario_repos(scenario_data))
            source_label = "scenario.yaml"
        except HarnessError as exc:
            findings.append(
                Finding(
                    "error",
                    "repo_source_unreadable",
                    f"scenario.yaml could not be read to resolve table rows: {exc}",
                    "Fix the scenario (validate-scenario reports details).",
                )
            )
    if source_keys is not None:
        for row in repo_rows:
            row["source"] = source_label
            if row["key"] not in source_keys:
                code = "repo_not_in_registry" if kind == "free" else "repo_not_in_scenario"
                findings.append(
                    Finding(
                        "error",
                        code,
                        f"Per-repo table declares repo '{row['key']}' which is not registered in {source_label}.",
                        "Reference a repo key from the declaration layer for this task mode.",
                    )
                )

    # --- mode-aware: free-task Candidate Scoping still pending ---
    if kind == "free" and "spec.md" in texts:
        body = extract_section_body(strip_marked_blocks(texts["spec.md"]), "Candidate Scoping")
        if body is not None and "TBD" in body:
            findings.append(
                Finding(
                    "warning",
                    "candidate_scoping_pending",
                    "Candidate Scoping in spec.md is still TBD.",
                    "The Planning Pass records the candidate repo set and provenance there.",
                )
            )

    status = "ok" if not any(item.level == "error" for item in findings) else "error"
    return {
        "status": status,
        "task_id": task_dir.name,
        "task_dir": str(task_dir),
        "mode": mode_label,
        "mode_raw": raw_mode,
        "baseline_source": str(root / "templates"),
        "files": file_reports,
        "current_step": current_step,
        "gates": gates,
        "repos": repo_rows,
        "findings": [item.to_dict() for item in findings],
    }


def print_check_task_report(report: dict[str, Any]) -> None:
    print(f"task_dir: {report['task_dir']}")
    print(f"task_id: {report['task_id']}")
    print(f"mode: {report.get('mode') or '-'}")
    print(f"baseline_source: {report['baseline_source']}")
    print(f"status: {report['status']}")
    print("")
    print("files:")
    for item in report["files"]:
        if not item.get("exists"):
            print(f"- {item['name']}: missing")
            continue
        missing = item.get("sections_missing") or []
        if missing:
            print(
                f"- {item['name']}: sections {item['sections_required'] - len(missing)}/{item['sections_required']} present, missing: {', '.join(missing)}"
            )
        else:
            print(f"- {item['name']}: sections {item['sections_required']}/{item['sections_required']} present")
    print("")
    print("repos:")
    for item in report["repos"]:
        print(
            f"- {item['key']} branch={item.get('branch') or '-'} source={item.get('source') or 'n/a'}"
        )
    print(f"current_step: {report.get('current_step') or '-'}")
    gates = report.get("gates") or {}
    print(
        "gates: planning={}, spec_review={}".format(
            gates.get("Planning Gate", "-"), gates.get("Spec Review Gate", "-")
        )
    )
    print("")
    if report["findings"]:
        print("findings:")
        for finding in report["findings"]:
            print(f"- [{finding['level']}] {finding['code']}: {finding['message']}")
            if finding.get("fix"):
                print(f"  fix: {finding['fix']}")
    else:
        print("findings: none")


def cmd_check_task(args: argparse.Namespace) -> int:
    root = harness_root()
    task_dir = resolve_task_dir(root, args.task_id)
    if not task_dir.is_dir():
        raise HarnessError(f"Task directory is missing: {task_dir}", EXIT_VALIDATION)
    report = check_task_structure(root, task_dir)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_check_task_report(report)
    return EXIT_OK if report["status"] == "ok" else EXIT_VALIDATION


class RunLock:
    """Single-writer advisory lock for one task directory (POSIX)."""

    def __init__(self, task_dir: Path):
        self.path = task_dir / ".run.lock"
        self.acquired = False

    def acquire(self) -> None:
        for _ in range(2):
            try:
                handle = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            except FileExistsError:
                if self._stale():
                    continue
                holder = self._holder()
                raise HarnessError(
                    f"Task is locked by another run ({holder}). Lock: {self.path}",
                    EXIT_USAGE,
                )
            with os.fdopen(handle, "w", encoding="utf-8") as file:
                file.write(f"pid={os.getpid()}\n")
                file.write(f"started={dt.datetime.now().isoformat(timespec='seconds')}\n")
            self.acquired = True
            return
        raise HarnessError(
            f"Could not acquire task lock after stale cleanup: {self.path}",
            EXIT_USAGE,
        )

    def _holder(self) -> str:
        try:
            return self.path.read_text(encoding="utf-8").strip().replace("\n", "; ")
        except OSError:
            return "unknown holder"

    def _stale(self) -> bool:
        try:
            text = self.path.read_text(encoding="utf-8")
        except OSError:
            return False
        match = re.search(r"pid=(\d+)", text)
        if not match:
            return False
        try:
            os.kill(int(match.group(1)), 0)
        except ProcessLookupError:
            try:
                self.path.unlink()
            except OSError:
                pass
            return True
        except PermissionError:
            return False
        return False

    def release(self) -> None:
        if not self.acquired:
            return
        self.acquired = False
        try:
            self.path.unlink()
        except OSError:
            pass


BASE_ENV_KEYS = (
    "PATH",
    "HOME",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "TERM",
    "TMPDIR",
    "SHELL",
    "USER",
    "LOGNAME",
    "TZ",
    "SSL_CERT_FILE",
    "REQUESTS_CA_BUNDLE",
)
ENV_PREFIX_ALLOWLIST = (
    "ANTHROPIC_",
    "OPENAI_",
    "GEMINI_",
    "GOOGLE_",
    "CODEX_",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
)


def child_env_overlay() -> dict[str, str]:
    """Explicit allowlist overlay; parent ambient variables are not inherited."""

    child_env: dict[str, str] = {}
    for name, value in os.environ.items():
        if name in BASE_ENV_KEYS or name.startswith(ENV_PREFIX_ALLOWLIST):
            child_env[name] = value
    return child_env


RUN_PERMISSION_PRESETS = ("workspace", "read-only", "full-access")

PERMISSION_FLAGS: dict[str, dict[str, list[str]]] = {
    "claude-code": {
        "workspace": ["--permission-mode", "acceptEdits"],
        "read-only": ["--permission-mode", "dontAsk"],
        "full-access": ["--permission-mode", "bypassPermissions"],
    },
    "codex": {
        "workspace": ["--sandbox", "workspace-write"],
        "read-only": ["--sandbox", "read-only"],
        "full-access": ["--dangerously-bypass-approvals-and-sandbox"],
    },
    "gemini": {"workspace": [], "read-only": [], "full-access": []},
}

AGENT_PROVIDERS: dict[str, str] = {
    "claude-code": "claude",
    "codex": "codex",
    "gemini": "gemini",
}

STDERR_SIGNATURES: tuple[tuple[str, str, str], ...] = (
    (
        "approval policy is Never",
        "permission_denied",
        "Agent backend rejected an escalation because the permission preset never asks.",
    ),
    (
        "recorded sandbox violation",
        "sandbox_violation",
        "Agent backend reported a sandbox violation.",
    ),
    (
        "does not have permission",
        "permission_denied",
        "Agent backend denied a permission request.",
    ),
    (
        "permission mode",
        "permission_denied",
        "Agent backend reported a permission-mode problem.",
    ),
)


def classify_stderr_signatures(stderr_text: str) -> tuple[str, str] | None:
    lowered = stderr_text.lower()
    for signature, category, reason in STDERR_SIGNATURES:
        if signature.lower() in lowered:
            return category, reason
    return None


VERDICT_KEYS = ("verdict", "blocker", "residual_risk")
VERDICT_VALUES = ("ok", "blocked")
VERDICT_LINE_RE = re.compile(r"^(verdict|blocker|residual_risk):\s*(.*)$")


@dataclass
class AgentVerdict:
    verdict: str
    blocker: str
    residual_risk: str


def verdict_file_path(task_dir: Path, repo_key: str) -> Path:
    return task_dir / "verdicts" / f"{repo_key}.md"


def parse_verdict_file(path: Path) -> tuple[str, AgentVerdict | None, str | None]:
    """Parse tasks/<task>/verdicts/<repo>.md under a fail-closed contract.

    Returns (status, verdict, reason). status is "missing", "invalid", "ok", or
    "blocked". Anything that is not exactly the three declared keys with a valid
    verdict value is invalid; a blocked verdict additionally requires a
    non-empty blocker line.
    """

    if not path.is_file():
        return "missing", None, None
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return "invalid", None, f"verdict file is unreadable: {exc}"
    values: dict[str, str] = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        match = VERDICT_LINE_RE.match(line)
        if match is None:
            return "invalid", None, f"unexpected line: {line!r}"
        key, value = match.group(1), match.group(2).strip()
        if key in values:
            return "invalid", None, f"duplicate key: {key}"
        values[key] = value
    missing_keys = [key for key in VERDICT_KEYS if key not in values]
    if missing_keys:
        return "invalid", None, f"missing key(s): {', '.join(missing_keys)}"
    verdict_value = values["verdict"]
    if verdict_value not in VERDICT_VALUES:
        return (
            "invalid",
            None,
            f"verdict value must be one of {'/'.join(VERDICT_VALUES)}, "
            f"got {verdict_value!r}",
        )
    if verdict_value == "blocked" and not values["blocker"]:
        return "invalid", None, "a blocked verdict requires a non-empty blocker line"
    return (
        verdict_value,
        AgentVerdict(
            verdict=verdict_value,
            blocker=values["blocker"],
            residual_risk=values["residual_risk"],
        ),
        None,
    )


def terminate_process_tree(process: subprocess.Popen, grace_seconds: float) -> None:
    """POSIX termination ladder: SIGTERM to the group, grace, then SIGKILL.

    Liveness is judged with poll() so a reaped (zombie) direct child counts as
    dead; the pgid is captured first because it is unavailable after exit.
    """

    try:
        pgid = os.getpgid(process.pid)
    except ProcessLookupError:
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pgid, sig)
        except (ProcessLookupError, PermissionError):
            return
        if sig == signal.SIGTERM:
            deadline = time.monotonic() + grace_seconds
            while time.monotonic() < deadline:
                if process.poll() is not None:
                    return
                time.sleep(0.2)


@dataclass
class AgentOutcome:
    exit_code: int | None
    signal_name: str | None
    timed_out: bool
    terminated_by_runner: bool
    duration_seconds: float
    stdout_text: str
    stderr_text: str


def spawn_agent(
    argv: list[str],
    cwd: Path,
    timeout_seconds: int,
    term_grace_seconds: float,
    log_path: Path,
) -> AgentOutcome:
    """Spawn one agent backend in its own session and wait under the timeout."""

    started = time.monotonic()
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("w", encoding="utf-8") as log:
        log.write(f"# agent argv: {json.dumps(argv)}\n")
        log.write(f"# cwd: {cwd}\n")
        log.write(f"# timeout_seconds: {timeout_seconds}\n\n")
        log.flush()
        try:
            process = subprocess.Popen(
                argv,
                cwd=str(cwd),
                env=child_env_overlay(),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                start_new_session=True,
            )
        except FileNotFoundError as exc:
            log.write(f"# spawn failed: executable not found: {argv[0]}\n")
            raise HarnessError(
                f"Agent executable not found on PATH: {argv[0]}. "
                f"Install the backend or choose another --agent.",
                EXIT_USAGE,
            ) from exc

        timed_out = False
        terminated_by_runner = False
        signal_name: str | None = None
        try:
            stdout_text, stderr_text = process.communicate(
                timeout=timeout_seconds if timeout_seconds > 0 else None
            )
        except subprocess.TimeoutExpired:
            timed_out = True
            terminated_by_runner = True
            terminate_process_tree(process, term_grace_seconds)
            stdout_text, stderr_text = process.communicate()
            signal_name = "SIGKILL/SIGTERM"

        if process.returncode is not None and process.returncode < 0:
            signal_name = signal_name or signal.Signals(-process.returncode).name

        log.write("## stdout\n\n")
        log.write(stdout_text or "")
        log.write("\n\n## stderr\n\n")
        log.write(stderr_text or "")
        log.write("\n")

    return AgentOutcome(
        exit_code=process.returncode,
        signal_name=signal_name,
        timed_out=timed_out,
        terminated_by_runner=terminated_by_runner,
        duration_seconds=time.monotonic() - started,
        stdout_text=stdout_text or "",
        stderr_text=stderr_text or "",
    )


def provider_argv(
    agent: str, permission: str, prompt: str, task_dir: Path | None = None
) -> list[str]:
    executable = AGENT_PROVIDERS[agent]
    flags = PERMISSION_FLAGS[agent][permission]
    if agent == "claude-code":
        # Two injections restore a working sandboxed session:
        # 1. Tool search defers local tools (Bash/Read/Write) behind a
        #    ToolSearch registry; on Anthropic-compatible third-party endpoints
        #    the deferred tools never surface, leaving headless sessions
        #    toolless (they still exit 0). --settings overrides the user's
        #    settings.json env block, restoring the classic eager tool surface.
        # 2. The task directory lives outside the repo cwd; without --add-dir
        #    every access path to it (Read/Bash/Write) is permission-denied,
        #    so verdicts and task-file updates cannot be written.
        # See docs/real-backend-acceptance.md (round 2, W1/W1B/E1/E2 evidence).
        argv = [
            executable,
            "-p",
            prompt,
            "--output-format",
            "json",
            "--settings",
            json.dumps({"env": {"ENABLE_TOOL_SEARCH": "0"}}),
        ]
        if task_dir is not None:
            argv += ["--add-dir", str(task_dir)]
        return [*argv, *flags]
    if agent == "codex":
        return [executable, "exec", "--json", *flags, prompt]
    return [executable, "-p", prompt, *flags]


def agent_success_is_strict(agent: str, outcome: AgentOutcome) -> tuple[bool, str | None]:
    """Strict success mapping: exit code 0 is necessary but not sufficient."""

    if outcome.exit_code != 0:
        return False, None
    if agent != "claude-code":
        return True, None
    parsed = None
    for line in reversed((outcome.stdout_text or "").strip().splitlines()):
        try:
            parsed = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict):
            break
        parsed = None
    if isinstance(parsed, dict):
        subtype = parsed.get("subtype")
        if isinstance(subtype, str) and subtype.startswith("error"):
            return False, f"claude-code result subtype is '{subtype}'"
    return True, None


def render_agent_prompt(
    context: dict[str, Any],
    repo: dict[str, Any],
    task_dir: Path,
    expected_branch: str | None,
    root: Path,
) -> str:
    instructions = repo.get("instruction_sources") or []
    key_files = repo.get("key_files") or []
    checks = repo.get("checks") or []
    dependencies = repo.get("depends_on") or []
    dependency_lines = markdown_dependencies(dependencies) if dependencies else "None."
    if context.get("mode") == "free":
        header = (
            f"You are the repo-local implementation agent for free task `{task_dir.name}`, "
            f"repo `{repo['key']}`."
        )
    else:
        header = (
            f"You are the repo-local implementation agent for scenario `{context['scenario']}`, "
            f"repo `{repo['key']}`."
        )
    return f"""{header}

Working directory: `{repo.get("path")}`
Expected task branch (exact match required): `{expected_branch or "TBD"}`

Follow this order and stop before editing if any step fails:

1. Run `git branch --show-current` and compare it exactly against the expected branch.
   If it does not match, do not read further context or edit anything: append the
   mismatch to `{task_dir / "status.md"}` under Blockers and exit non-zero.
2. Read the repo-local instruction sources in order (skip missing files and record
   the skip in `{task_dir / "status.md"}` under Notes):
{markdown_list(instructions, "   (none declared; inspect README.md and CONTRIBUTING.md instead)")}

3. Inspect the declared key files (scenario.yaml or repos.yaml) as needed:
{markdown_list(key_files, "   (none declared)")}

4. Reconcile repo-local spec entries. If `{task_dir / "spec.md"}` references spec
   entries authored in this repo during planning, first run the repo's
   spec-framework scaffold/registration flow exactly as its instruction sources
   document, then merge the planning-authored content into it. Planning content
   is authoritative; keep the reconciliation diff visible in the repo. If the
   spec records a document-level-creation fallback for this repo, implement from
   the inline workspace spec instead.
5. Implement the repo-local change described in `{task_dir / "spec.md"}`, following
   the repo-local spec entries it references instead of re-designing them.
   Upstream dependencies consumed by this repo:
   {dependency_lines}
6. If your work reveals that another repository is affected, do not edit that
   repository: record the finding in `{task_dir / "status.md"}` and surface it in
   your verdict (residual_risk, or blocked) so the runner can trigger replanning.
7. Update the task files so the coordinating runner can recover state:
   - append implementation notes to `{task_dir / "spec.md"}` if the plan deepened
   - set per-repo status in `{task_dir / "status.md"}`
   - record deviations in `{task_dir / "decisions.md"}`
8. Write your delivery verdict to `{verdict_file_path(task_dir, repo["key"])}` (create
   the `verdicts` directory if needed) with exactly these three lines and nothing else:
   verdict: ok
   blocker: <one line, "none" when you are not blocked>
   residual_risk: <one line, "none" when there is none>
   Use `verdict: blocked` with a non-empty blocker line when the repo-local change is
   not fully implemented. The runner reads this file after you exit: a missing or
   malformed file, or a blocked verdict, blocks the run even when you exit 0.
9. Do NOT run git commit, push, branch creation, or checkout. Do not modify git state.

The coordinating runner will read your verdict file and run the repo checks itself
after you exit:
{markdown_list(checks, "   (none declared)")}

Harness protocol reference: `{root / "AGENTS.md"}`. Exit 0 with verdict `ok` only
when the repo-local change is implemented and task files are updated."""


def render_run_status(report: dict[str, Any]) -> str:
    rows = []
    for repo in report["repos"]:
        rows.append(
            "| {key} | {branch} | {agent} | {verdict} | {checks} | {result} |".format(
                key=repo["key"],
                branch=repo.get("branch_gate") or "-",
                agent=repo.get("agent_result") or "-",
                verdict=repo.get("verdict") or "-",
                checks=repo.get("checks_result") or "-",
                result=repo.get("result") or "-",
            )
        )
    failure = report.get("failure")
    failure_lines = (
        f"- stage: {failure['stage']}; category: {failure['category']}; repo: "
        f"{failure.get('repo') or '-'}; {failure['message']}"
        if failure
        else "None."
    )
    return f"""## Agent Run Report

Generated: `{report["generated_at"]}`

Runner: `{report["agent_backend"]}` (permission preset `{report["permission"]}`)

Gates: planning `{report["gates"]["planning_gate"]}`, spec review `{report["gates"]["spec_review_gate"]}`

| Repo | Branch Gate | Agent | Verdict | Checks | Result |
| --- | --- | --- | --- | --- | --- |
{chr(10).join(rows) if rows else "| - | - | - | - | - | - |"}

Recommended current step: `{report["recommended_step"]}`

Failure:

{failure_lines}
"""


def render_run_validation(report: dict[str, Any]) -> str:
    rows = []
    for repo in report["repos"]:
        outcome = repo.get("agent_outcome") or {}
        rows.append(
            "| {key} | `{agent}` | `{log}` | {verdict} | exit={exit_code} timeout={timeout} | {result} |".format(
                key=repo["key"],
                agent=report["agent_backend"],
                log=repo.get("log_path") or "-",
                verdict=repo.get("verdict") or "-",
                exit_code=outcome.get("exit_code"),
                timeout=outcome.get("timed_out"),
                result=repo.get("result") or "-",
            )
        )
    failure = report.get("failure")
    failure_lines = (
        f"- stage `{failure['stage']}` x category `{failure['category']}` at repo "
        f"`{failure.get('repo') or '-'}`: {failure['message']}"
        if failure
        else "None."
    )
    return f"""## Agent Run Telemetry

Generated: `{report["generated_at"]}`

| Repo | Backend | Log | Verdict | Agent Outcome | Result |
| --- | --- | --- | --- | --- | --- |
{chr(10).join(rows) if rows else "| - | - | - | - | - | - |"}

Failure classification:

{failure_lines}

Raw agent output is kept under the task `logs/` directory; this file records the
summary only.
"""


def cmd_run(args: argparse.Namespace) -> int:
    if os.name != "posix":
        raise HarnessError(
            "run requires POSIX process groups (macOS/Linux); Windows is not supported.",
            EXIT_USAGE,
        )

    root = harness_root()
    dry_run_path_codes = {"repo_path_missing", "repo_path_not_git"}
    free_mode = False
    label: str | None = args.scenario
    task_dir: Path | None = None

    if args.scenario:
        validation = validate_scenario(root, args.scenario)
        validation_refused = "Scenario validation failed; run refused. Fix findings first: "
    else:
        # The single seam: without a scenario argument the mode comes from the
        # task's status.md. A free task builds its context from the task
        # declaration + repos.yaml; everything after the context (prompt
        # rendering, branch gates, verdicts, checks) is mode-agnostic.
        task_dir = resolve_task_dir(root, args.task)
        if not task_dir.exists() or not (task_dir / "status.md").exists():
            raise HarnessError(
                f"Task directory with status.md is required: {task_dir}",
                EXIT_USAGE,
            )
        kind, name = read_task_mode(task_dir)
        if kind == "free":
            free_mode = True
            label = "free"
            validation = validate_registry(root)
            validation_refused = "Registry validation failed; run refused. Fix findings first: "
        elif kind == "scenario" and name:
            label = name
            validation = validate_scenario(root, name)
            validation_refused = "Scenario validation failed; run refused. Fix findings first: "
        else:
            raise HarnessError(
                "run requires a scenario argument, or a task whose status.md records "
                "`mode: free` / `mode: scenario:<name>` (legacy: a `Scenario:` line).",
                EXIT_USAGE,
            )

    fatal_findings = [
        finding
        for finding in validation["findings"]
        if finding["level"] == "error"
        and not (args.dry_run and finding["code"] in dry_run_path_codes)
    ]
    if fatal_findings:
        raise HarnessError(
            validation_refused
            + "; ".join(f"{item['code']}: {item['message']}" for item in fatal_findings),
            EXIT_VALIDATION,
        )

    if task_dir is None:
        task_dir = resolve_task_dir(root, args.task)
    if not task_dir.exists() or not (task_dir / "status.md").exists():
        raise HarnessError(
            f"Task directory with status.md is required: {task_dir}",
            EXIT_USAGE,
        )

    if free_mode:
        context = free_task_context(root, task_dir)
    else:
        context = scenario_context(root, args.scenario)
    if args.repo:
        selected_repos = [repo for repo in context["repos"] if repo["key"] == args.repo]
        if not selected_repos:
            if free_mode:
                raise HarnessError(
                    f"Task-declared repo set does not include repo '{args.repo}'.",
                    EXIT_USAGE,
                )
            raise HarnessError(
                f"Scenario '{args.scenario}' does not include repo '{args.repo}'.",
                EXIT_USAGE,
            )
    else:
        selected_repos = list(context["repos"])

    expected_branches = read_task_branches(task_dir)
    if free_mode:
        defaults = read_task_branch_defaults(task_dir)
        for repo in context["repos"]:
            if not expected_branches.get(repo["key"]):
                fallback = defaults["overrides"].get(repo["key"]) or defaults["default"]
                if fallback:
                    expected_branches[repo["key"]] = fallback
    report: dict[str, Any] = {
        "scenario": label,
        "mode": "free" if free_mode else "scenario",
        "task_dir": str(task_dir),
        "agent_backend": args.agent,
        "permission": args.permission,
        "dry_run": args.dry_run,
        "timeout_seconds": args.timeout,
        "generated_at": dt.datetime.now().isoformat(timespec="seconds"),
        "repos": [],
        "failure": None,
        "recommended_step": "blocked",
    }

    def write_task_blocks() -> None:
        upsert_marked_block(
            task_dir / "status.md", "run-status", render_run_status(report)
        )
        upsert_marked_block(
            task_dir / "validation.md", "run-validation", render_run_validation(report)
        )

    def fail(stage: str, category: str, message: str, repo_key: str | None = None) -> int:
        report["failure"] = {
            "stage": stage,
            "category": category,
            "message": message,
            "repo": repo_key,
        }
        report["recommended_step"] = "blocked"
        write_task_blocks()
        print(
            f"error: run blocked at stage={stage} category={category}"
            + (f" repo={repo_key}" if repo_key else "")
            + f": {message}",
            file=sys.stderr,
        )
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        return EXIT_VALIDATION

    if args.dry_run:
        report["gates"] = {"planning_gate": "skipped(dry-run)", "spec_review_gate": "skipped(dry-run)"}
        report["recommended_step"] = "dry-run"
        for repo in selected_repos:
            prompt = render_agent_prompt(
                context, repo, task_dir, expected_branches.get(repo["key"]), root
            )
            argv = provider_argv(args.agent, args.permission, prompt, task_dir)
            report["repos"].append(
                {
                    "key": repo["key"],
                    "branch_gate": expected_branches.get(repo["key"]) or "TBD",
                    "prompt": prompt,
                    "argv": argv,
                    "result": "dry-run",
                }
            )
            print(f"--- repo: {repo['key']} ---")
            print(f"argv: {json.dumps(argv[:6])} ...")
            print(prompt)
            print("")
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        return EXIT_OK

    gates = task_gates_ready(task_dir)
    report["gates"] = gates
    if gates["planning_gate"] != "ready":
        return fail(
            "gates",
            "planning_gate_missing",
            "Planning Gate is not recorded as complete in status.md "
            "(current step must reach planning_complete, or a Planning Gate section must record it).",
        )
    if gates["spec_review_gate"] != "ready":
        return fail(
            "gates",
            "spec_review_gate_missing",
            "Spec Review Gate is not approved or explicitly skipped in status.md "
            "(current step must reach spec_review_approved, or a Spec Review Gate section "
            "must record approval or a user-authorized skip).",
        )

    lock = RunLock(task_dir)
    lock.acquire()
    try:
        for repo in selected_repos:
            repo_key = repo["key"]
            repo_path = repo.get("path")
            entry: dict[str, Any] = {"key": repo_key, "result": "pending"}
            report["repos"].append(entry)

            if free_mode:
                preflight = collect_preflight(
                    root,
                    label,
                    expected_branches,
                    context=context,
                    validation=validation,
                    path_source="repos.yaml",
                )
            else:
                preflight = collect_preflight(
                    root, args.scenario, expected_branches
                )
            repo_preflight = next(
                (item for item in preflight["repos"] if item["key"] == repo_key), None
            )
            if repo_preflight is None or repo_preflight["branch_result"] != "pass":
                branch_gate = (
                    repo_preflight["branch_result"]
                    if repo_preflight
                    else "missing"
                )
                entry["branch_gate"] = branch_gate
                entry["result"] = "blocked"
                return fail(
                    "preflight",
                    "branch_mismatch"
                    if branch_gate == "fail"
                    else f"branch_{branch_gate}",
                    f"Repo '{repo_key}' branch gate is '{branch_gate}' "
                    f"(expected '{expected_branches.get(repo_key) or 'TBD'}', "
                    f"actual '{(repo_preflight or {}).get('actual_branch') or '-'}'). "
                    "The runner never switches branches.",
                    repo_key,
                )
            entry["branch_gate"] = "pass"

            prompt = render_agent_prompt(
                context, repo, task_dir, expected_branches.get(repo_key), root
            )
            argv = provider_argv(args.agent, args.permission, prompt, task_dir)
            log_path = task_dir / "logs" / f"{repo_key}.log"
            entry["log_path"] = str(log_path)

            repo_verdict_file = verdict_file_path(task_dir, repo_key)
            # Fail-closed across retries: a verdict left over from an earlier run
            # must not satisfy this run's gate.
            try:
                repo_verdict_file.unlink(missing_ok=True)
            except OSError:
                pass

            outcome = spawn_agent(
                argv,
                Path(repo_path or "."),
                args.timeout,
                args.term_grace,
                log_path,
            )
            entry["agent_outcome"] = {
                "exit_code": outcome.exit_code,
                "signal": outcome.signal_name,
                "timed_out": outcome.timed_out,
                "terminated_by_runner": outcome.terminated_by_runner,
                "duration_seconds": round(outcome.duration_seconds, 2),
            }

            if outcome.timed_out:
                entry["agent_result"] = "timeout"
                entry["result"] = "blocked"
                return fail(
                    "agent",
                    "timeout",
                    f"Agent for '{repo_key}' timed out after {args.timeout}s and the "
                    "process group was terminated by the runner.",
                    repo_key,
                )
            strict_ok, strict_reason = agent_success_is_strict(args.agent, outcome)
            if not strict_ok:
                if strict_reason:
                    entry["agent_result"] = "invalid-success"
                    entry["result"] = "blocked"
                    return fail(
                        "agent", "invalid_success", strict_reason, repo_key
                    )
                signature = classify_stderr_signatures(outcome.stderr_text or "")
                category, message = (
                    (signature[0], signature[1])
                    if signature
                    else (
                        "nonzero_exit",
                        f"Agent for '{repo_key}' exited with code {outcome.exit_code}"
                        + (f" ({outcome.signal_name})" if outcome.signal_name else "")
                        + ". See the raw log for details.",
                    )
                )
                entry["agent_result"] = category
                entry["result"] = "blocked"
                return fail("agent", category, message, repo_key)
            entry["agent_result"] = "success"

            verdict_status, verdict, verdict_reason = parse_verdict_file(
                repo_verdict_file
            )
            entry["verdict"] = verdict_status
            if verdict_status == "missing":
                entry["agent_result"] = "verdict_missing"
                entry["result"] = "blocked"
                return fail(
                    "agent",
                    "verdict_missing",
                    f"Agent for '{repo_key}' exited 0 but wrote no verdict file at "
                    f"`{repo_verdict_file}`. A missing verdict counts as failure.",
                    repo_key,
                )
            if verdict_status == "invalid":
                entry["agent_result"] = "verdict_invalid"
                entry["result"] = "blocked"
                return fail(
                    "agent",
                    "verdict_invalid",
                    f"Verdict file for '{repo_key}' is malformed: {verdict_reason}",
                    repo_key,
                )
            if verdict_status == "blocked":
                entry["agent_result"] = "agent_report_blocked"
                entry["result"] = "blocked"
                residual = (
                    verdict.residual_risk
                    if verdict and verdict.residual_risk
                    and verdict.residual_risk != "none"
                    else None
                )
                return fail(
                    "agent",
                    "agent_report_blocked",
                    f"Agent for '{repo_key}' self-reported a blocked verdict: "
                    f"{verdict.blocker if verdict else '-'}"
                    + (f" (residual risk: {residual})" if residual else "")
                    + ". Checks are skipped for a self-reported blocked verdict.",
                    repo_key,
                )

            if free_mode:
                checks_report = run_checks(
                    checks_matrix_from_context(context, repo_key), args.check_timeout
                )
            else:
                checks_report = run_checks(
                    check_matrix(root, args.scenario, repo_key), args.check_timeout
                )
            failed = [
                item for item in checks_report["results"] if item["result"] != "pass"
            ]
            if failed:
                entry["checks_result"] = "fail"
                entry["result"] = "blocked"
                first = failed[0]
                return fail(
                    "checks",
                    "check_timeout" if first["result"] == "timeout" else "check_failed",
                    f"Repo '{repo_key}' check failed: `{first['command']}` "
                    f"({first['result']}, exit {first.get('exit_code')}). "
                    "Checks are run by the runner, not trusted from the agent.",
                    repo_key,
                )
            entry["checks_result"] = "pass"
            entry["result"] = "complete"
            report["recommended_step"] = f"repo_complete:{repo_key}"
            write_task_blocks()

        report["recommended_step"] = "complete"
        write_task_blocks()
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print(f"status: complete ({len(selected_repos)} repo(s))")
            for repo in report["repos"]:
                print(
                    f"- repo={repo['key']} branch={repo.get('branch_gate')} "
                    f"agent={repo.get('agent_result')} checks={repo.get('checks_result')} "
                    f"result={repo['result']}"
                )
        return EXIT_OK
    finally:
        lock.release()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="repomesh",
        description="Agent-friendly helpers for cross-repo RepoMesh workflows.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    validate = subparsers.add_parser(
        "validate-scenario",
        help="Validate scenario config, repo paths, checks, and basic field shapes.",
    )
    validate.add_argument("scenario", help="Scenario directory name under scenarios/.")
    validate.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    validate.set_defaults(func=cmd_validate)

    validate_registry_parser = subparsers.add_parser(
        "validate-registry",
        help="Validate the workspace registry repos.yaml: structure, edges, paths, "
        "task-value ban, and scenario cross-check (Q4-a, warning level).",
    )
    validate_registry_parser.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    validate_registry_parser.set_defaults(func=cmd_validate_registry)

    init_task = subparsers.add_parser(
        "init-task",
        help="Create scenario task files from scenario.yaml without overwriting existing files.",
    )
    init_task.add_argument(
        "scenario",
        nargs="?",
        help="Scenario directory name under scenarios/. Omit with --free.",
    )
    init_task.add_argument(
        "task_id", nargs="?", help="Task directory name under tasks/."
    )
    init_task.add_argument(
        "--free",
        action="store_true",
        help="Scaffold a free task: validates repos.yaml instead of a scenario and "
        "records mode: free. Requires a task id.",
    )
    init_task.add_argument(
        "--request", default="", help="User request text to place in spec.md."
    )
    init_task.add_argument(
        "--branch",
        help="Shared expected branch for this task. Defaults to scenario/<task-id>.",
    )
    init_task.add_argument(
        "--repo-branch",
        action="append",
        help="Per-repo expected branch override as REPO=BRANCH. May be repeated.",
    )
    init_task.add_argument(
        "--allow-invalid",
        action="store_true",
        help="Create task files even when scenario validation reports errors.",
    )
    init_task.add_argument(
        "--dry-run", action="store_true", help="Preview files without writing them."
    )
    init_task.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    init_task.set_defaults(func=cmd_init_task)

    preflight = subparsers.add_parser(
        "preflight",
        help="Inspect affected repos and optionally update task status and validation files.",
    )
    preflight.add_argument(
        "scenario",
        nargs="?",
        help="Scenario directory name under scenarios/. Omit with --task for a "
        "task-driven preflight (free tasks resolve repos from the registry).",
    )
    preflight.add_argument(
        "--task",
        help="Task id under tasks/ or a task directory path. When present, status.md and validation.md are updated.",
    )
    preflight.add_argument(
        "--no-write", action="store_true", help="Do not update task files."
    )
    preflight.add_argument(
        "--branch", help="Shared expected branch for this preflight run."
    )
    preflight.add_argument(
        "--repo-branch",
        action="append",
        help="Per-repo expected branch override as REPO=BRANCH. May be repeated.",
    )
    preflight.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    preflight.set_defaults(func=cmd_preflight)

    plan = subparsers.add_parser(
        "plan-scenario",
        help="Print the selected scenario order, repo paths, key files, and checks.",
    )
    plan.add_argument("scenario", help="Scenario directory name under scenarios/.")
    plan.add_argument("--json", action="store_true", help="Emit stable JSON output.")
    plan.set_defaults(func=cmd_plan)

    list_tasks = subparsers.add_parser(
        "list-tasks",
        help="List task directories matching a scenario, newest first.",
    )
    list_tasks.add_argument(
        "scenario",
        nargs="?",
        help="Scenario directory name under scenarios/. Omit to list free tasks.",
    )
    list_tasks.add_argument(
        "--all",
        action="store_true",
        help="List tasks of every mode instead of free tasks only.",
    )
    list_tasks.add_argument(
        "--incomplete-only",
        action="store_true",
        help="Hide tasks that appear complete.",
    )
    list_tasks.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    list_tasks.set_defaults(func=cmd_list_tasks)

    checks = subparsers.add_parser(
        "checks",
        help="List repo-local checks, or run them with --run.",
    )
    checks.add_argument(
        "scenario",
        nargs="?",
        help="Scenario directory name under scenarios/. Omit with --task for "
        "task-driven checks (free tasks: checks from the registry).",
    )
    checks.add_argument("--repo", help="Limit to one repo key from the scenario.")
    checks.add_argument(
        "--run",
        action="store_true",
        help="Execute checks. Without this flag, only list them.",
    )
    checks.add_argument(
        "--task", help="Task id or path. With --run, updates validation.md."
    )
    checks.add_argument(
        "--timeout-seconds",
        type=int,
        default=900,
        help="Per-command timeout when using --run.",
    )
    checks.add_argument("--json", action="store_true", help="Emit stable JSON output.")
    checks.set_defaults(func=cmd_checks)

    check_task = subparsers.add_parser(
        "check-task",
        help="Lint a task directory's file structure against the templates/ skeleton.",
    )
    check_task.add_argument(
        "task_id",
        help="Task id under tasks/ or a task directory path.",
    )
    check_task.add_argument(
        "--json", action="store_true", help="Emit stable JSON output."
    )
    check_task.set_defaults(func=cmd_check_task)

    run = subparsers.add_parser(
        "run",
        help="Execute the per-repo subprocess agent layer for a gated task.",
    )
    run.add_argument(
        "scenario",
        nargs="?",
        help="Scenario directory name under scenarios/. Omit for a free task "
        "(mode read from the task's status.md; repo set from the task "
        "declaration + repos.yaml).",
    )
    run.add_argument(
        "--task",
        required=True,
        help="Task id under tasks/ or a task directory path with status.md.",
    )
    run.add_argument(
        "--repo",
        help="Run a single repo key from the scenario instead of the full order.",
    )
    run.add_argument(
        "--agent",
        choices=sorted(AGENT_PROVIDERS),
        default="claude-code",
        help="Agent backend provider. Default: claude-code.",
    )
    run.add_argument(
        "--permission",
        choices=RUN_PERMISSION_PRESETS,
        default="workspace",
        help="Non-interactive permission preset. Default: workspace "
        "(edits allowed, escalations denied). read-only cannot implement.",
    )
    run.add_argument(
        "--timeout",
        type=int,
        default=1800,
        help="Per-repo agent timeout in seconds. 0 disables. Default: 1800.",
    )
    run.add_argument(
        "--check-timeout",
        type=int,
        default=900,
        help="Per-check-command timeout in seconds. Default: 900.",
    )
    run.add_argument(
        "--term-grace",
        type=float,
        default=10.0,
        help="Seconds between SIGTERM and SIGKILL in the termination ladder.",
    )
    run.add_argument(
        "--dry-run",
        action="store_true",
        help="Render per-repo prompts and argv without gates, lock, or spawn.",
    )
    run.add_argument("--json", action="store_true", help="Emit stable JSON output.")
    run.set_defaults(func=cmd_run)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except HarnessError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
